# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=infer @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# @envFlag=APP_ENV
# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=forEnv(development), account=taylormacd.1password.com)
# ----------

# @type=enum("development", "staging", "test", "production")
APP_ENV="development"

# @required @sensitive
TURSO_DATABASE_URL=
# @required @sensitive
TURSO_AUTH_TOKEN=

# Dedicated Turso for search_documents (staging during this work).
# Stream guests keep using TURSO_* above so production guest data is untouched.
# @required @sensitive
TURSO_SEARCH_DATABASE_URL=
# @required @sensitive
TURSO_SEARCH_AUTH_TOKEN=

# @type=port
PORT=4321

# URL from Netlify (deploy preview URL, prod URL etc.)
# @required
URL=

# @required @sensitive
GITHUB_TOKEN=

# @required @sensitive
DEV_API_KEY=

# @required @sensitive
GEMINI_API_KEY=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# @required=forEnv(production)
GA_MEASUREMENT_ID=

# Dedicated Turso database for EmDash. A new database, not TURSO_DATABASE_URL or TURSO_SEARCH_DATABASE_URL.
# Auth uses the existing TURSO_AUTH_TOKEN.
# @required @sensitive
EMDASH_TURSO_DATABASE_URL=
# Shared secret for the Netlify scheduled-publish function.
# @required @sensitive
EMDASH_SCHEDULE_SECRET=

# Netlify sets this on every deploy. On the production branch it is the
# branch subdomain (https://main--<site>.netlify.app), not the custom domain.
# EmDash uses it only for deploy previews and non-production branch deploys.
# @required=false
DEPLOY_PRIME_URL=
