{
  "version": "1",
  "meta": {
    "name": "Guests and livestreams",
    "description": "EmDash collections for livestream guests and episodes. Content is imported separately as drafts from stream_guests (read-only)."
  },
  "collections": [
    {
      "slug": "guests",
      "label": "Guests",
      "labelSingular": "Guest",
      "description": "People who appear on livestreams. Bio is filled in the CMS over time.",
      "icon": "users",
      "supports": ["drafts", "revisions", "preview", "search"],
      "urlPattern": "/guests/{slug}",
      "routable": true,
      "titleField": "title",
      "group": "Livestreams",
      "fields": [
        {
          "slug": "title",
          "label": "Name",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "role",
          "label": "Role / title",
          "type": "string",
          "searchable": true
        },
        {
          "slug": "image",
          "label": "Photo",
          "type": "image"
        },
        {
          "slug": "bio",
          "label": "Bio",
          "type": "portableText",
          "searchable": true
        },
        {
          "slug": "twitter",
          "label": "X / Twitter",
          "type": "string"
        },
        {
          "slug": "twitch",
          "label": "Twitch",
          "type": "string"
        },
        {
          "slug": "github",
          "label": "GitHub",
          "type": "string"
        },
        {
          "slug": "youtube",
          "label": "YouTube",
          "type": "string"
        },
        {
          "slug": "bluesky",
          "label": "Bluesky",
          "type": "string"
        },
        {
          "slug": "website",
          "label": "Website",
          "type": "string"
        },
        {
          "slug": "linkedin",
          "label": "LinkedIn",
          "type": "string"
        },
        {
          "slug": "livestreams",
          "label": "Livestreams",
          "type": "reference",
          "validation": {
            "relation": "livestream_guests",
            "relationSide": "child"
          }
        }
      ]
    },
    {
      "slug": "livestreams",
      "label": "Livestreams",
      "labelSingular": "Livestream",
      "description": "Livestream / video episodes. Guests are linked via references.",
      "icon": "broadcast",
      "supports": ["drafts", "revisions", "preview", "scheduling", "search"],
      "urlPattern": "/videos/{slug}",
      "routable": true,
      "titleField": "title",
      "dateField": "date",
      "group": "Livestreams",
      "admin": {
        "listColumns": ["date", "type"]
      },
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "type",
          "label": "Show",
          "type": "select",
          "required": true,
          "validation": {
            "options": ["nickyt.live", "pomerium-live"]
          }
        },
        {
          "slug": "date",
          "label": "Date",
          "type": "datetime",
          "required": true,
          "indexed": true
        },
        {
          "slug": "description",
          "label": "Description",
          "type": "text",
          "required": true,
          "searchable": true
        },
        {
          "slug": "youtube_stream_link",
          "label": "YouTube stream link",
          "type": "string"
        },
        {
          "slug": "linkedin_stream_link",
          "label": "LinkedIn stream link",
          "type": "string"
        },
        {
          "slug": "guests",
          "label": "Guests",
          "type": "reference",
          "validation": {
            "relation": "livestream_guests"
          }
        },
        {
          "slug": "source_stream_guest_id",
          "label": "Source stream_guests id",
          "type": "string",
          "unique": true,
          "indexed": true
        }
      ]
    }
  ],
  "relations": [
    {
      "slug": "livestream_guests",
      "parentCollection": "livestreams",
      "childCollection": "guests",
      "parentLabel": "Livestreams",
      "parentLabelSingular": "Livestream",
      "childLabel": "Guests",
      "childLabelSingular": "Guest"
    }
  ]
}
