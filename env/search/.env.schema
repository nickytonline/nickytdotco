# ----------

# @type=enum("development", "staging", "test", "production")
APP_ENV="development"

# @required @sensitive
GEMINI_API_KEY=

# @required @sensitive
TURSO_SEARCH_DATABASE_URL=
# @required @sensitive
TURSO_SEARCH_AUTH_TOKEN=

# Optional: production guests DB. When unset, stream pages are omitted from search.
# @sensitive
TURSO_DATABASE_URL=
# @sensitive
TURSO_AUTH_TOKEN=
