---
import { getEntry, getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content"; // used for related-content casts below
import Layout from "../../layouts/MainLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import TagList from "../../components/TagList.astro";
import RelatedContent from "../../components/RelatedContent.astro";
import { getRelatedTalks, getRelatedPostsForTalk } from "../../utils/tag-utils";
import { getYouTubeId } from "../../utils/youtube-utils";
import { dateFilter } from "../../utils/filters";
import { site } from "../../data/site";
import { Image } from "astro:assets";
import YouTubeEmbed from "../../components/embeds/YouTubeEmbed.astro";
import UpcomingBadge from "../../components/UpcomingBadge.astro";
export const prerender = true;

export async function getStaticPaths() {
  const talks = await getCollection("talks");
  return talks.map((talk) => ({ params: { slug: talk.id } }));
}

const { slug } = Astro.params;

if (!slug) {
  throw new Error("Talk not found");
}

const talk = await getEntry("talks", slug);

if (!talk) {
  throw new Error("Talk not found");
}

const { title, date, venue, tags = [] } = talk.data;
const { Content } = await render(talk);

const isUpcoming = talk.data.upcoming === true;
const venueUrl = venue.url;
const venueLocation = venue.location;
const endDate = talk.data.endDate;
const video = talk.data.video;
const slideDeck = talk.data.slideDeck;
const sourceCode = talk.data.sourceCode;
const sessionUrl = talk.data.sessionUrl;
const registrationUrl = talk.data.registrationUrl;
const additionalLinks = talk.data.additionalLinks ?? [];
const coverImage = talk.data.cover_image;
const coverImageLarge = talk.data.cover_image_large;
const isMultiDayEvent =
  isUpcoming &&
  endDate &&
  new Date(endDate).toISOString().slice(0, 10) !==
    new Date(date).toISOString().slice(0, 10);

const dateDisplay = isMultiDayEvent
  ? `${dateFilter(date)} – ${dateFilter(endDate)}`
  : dateFilter(date);
const talkMetaTitle = `${title} — ${venue.name} — ${dateDisplay}`;

// Get all talks to find related ones (past talks only)
const allTalks = await getCollection("talks");
const relatedTalks = isUpcoming
  ? []
  : getRelatedTalks(talk as CollectionEntry<"talks">, allTalks, 3);

// Get related blog posts by shared tags
const allPosts = await getCollection("blog");
const relatedPosts = getRelatedPostsForTalk(
  talk as CollectionEntry<"talks">,
  allPosts,
  3,
);

// Use the talk's video thumbnail or cover image as the Open Graph image
let thumbnailUrl: string | undefined;
if (video?.type === "youtube") {
  const videoId = getYouTubeId(video.url);
  if (videoId) {
    thumbnailUrl = `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`;
  }
} else if (video?.type === "custom" && video.image) {
  thumbnailUrl = video.image.url;
} else if (coverImageLarge) {
  thumbnailUrl = coverImageLarge;
} else if (coverImage) {
  thumbnailUrl = coverImage;
}

const pageUrl = new URL(Astro.url.pathname, site.url).toString();
const talkDescription = `${title} — a talk by Nick Taylor at ${venue.name} on ${dateDisplay}.`;
const venuePageUrl = venueUrl
  ? new URL(venueUrl, site.url).toString()
  : undefined;
const isVirtualVenue =
  /live stream|online|virtual/i.test(venue.name) ||
  venuePageUrl?.includes("youtube.com");
const eventLocation = isVirtualVenue
  ? {
      "@type": "VirtualLocation",
      name: venue.name,
      ...(venuePageUrl && { url: venuePageUrl }),
    }
  : {
      "@type": "Place",
      name: venue.name,
      ...(venueLocation && { address: venueLocation }),
      ...(venuePageUrl && { url: venuePageUrl }),
    };
const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  "@id": `${pageUrl}#event`,
  name: title,
  description: talkDescription,
  startDate: date.toISOString(),
  ...(endDate && { endDate: endDate.toISOString() }),
  eventStatus: isUpcoming
    ? "https://schema.org/EventScheduled"
    : "https://schema.org/EventCompleted",
  ...(isVirtualVenue && {
    eventAttendanceMode: "https://schema.org/OnlineEventAttendanceMode",
  }),
  location: eventLocation,
  ...(thumbnailUrl && {
    image: new URL(thumbnailUrl, site.url).toString(),
  }),
  url: pageUrl,
  performer: {
    "@type": "Person",
    name: site.authorName,
    url: site.url,
  },
  organizer: {
    "@type": "Organization",
    name: venue.name,
    ...(venuePageUrl && { url: venuePageUrl }),
  },
};
---

<Layout
  title={`${talkMetaTitle} | Nick Taylor's Talks`}
  metaDesc={talkDescription}
  socialImage={thumbnailUrl ?? "/assets/images/page-og/talks.jpg"}
  pageType="Talk"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(eventJsonLd)}
    />
  </Fragment>
  <Breadcrumb
    items={[
      { label: "Speaking", href: "/speaking" },
      { label: "Talks", href: "/talks" },
      { label: title },
    ]}
  />

  <article>
    <header class="space-y-5">
      <h1
        class="text-4xl lg:text-5xl font-extrabold tracking-tight text-foreground leading-tight"
        data-pagefind-meta="title"
      >
        {title}
      </h1>
      <div class="text-lg text-muted-foreground space-y-3">
        <div class="flex flex-wrap items-center gap-2 leading-none">
          {
            venueUrl ? (
              <a
                href={venueUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold text-brand hover:underline focus:underline focus:outline-none"
              >
                {venue.name}
              </a>
            ) : (
              <span class="font-semibold text-brand">{venue.name}</span>
            )
          }
          {isUpcoming && <UpcomingBadge label="Upcoming talk" />}
        </div>
        <div class="flex flex-wrap items-center gap-2 leading-relaxed">
          {venueLocation && <span>{venueLocation}</span>}
          <time datetime={date.toISOString()} class="italic">
            {dateDisplay}
          </time>
        </div>
      </div>
    </header>

    {
      video ? (
        <div class="my-6">
          {video.type === "youtube" && (
            <YouTubeEmbed
              videoId={getYouTubeId(video.url) || ""}
              startTime={(() => {
                try {
                  const t = new URL(video.url).searchParams.get("t");
                  return t ? t.replace(/s$/, "") : undefined;
                } catch {
                  return undefined;
                }
              })()}
              title={title}
            />
          )}
          {video.type === "vimeo" && (
            <div class="relative w-full aspect-video rounded-xl overflow-hidden border-2 border-border shadow-lg">
              <iframe
                src={video.url.replace("vimeo.com/", "player.vimeo.com/video/")}
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
                class="absolute inset-0 w-full h-full"
                title="Vimeo video player"
              />
            </div>
          )}
          {video.type === "custom" && video.image && (
            <a
              href={video.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block hover:opacity-90 focus:opacity-90 transition-opacity"
            >
              <img
                src={video.image.url}
                width={video.image.width}
                height={video.image.height}
                alt="Talk video preview"
                class="rounded-xl border-2 border-border shadow-lg w-full"
              />
            </a>
          )}
        </div>
      ) : isUpcoming && coverImageLarge ? (
        <div class="my-6">
          <Image
            src={coverImageLarge}
            alt={`${title} at ${venue.name}`}
            width={1600}
            height={900}
            class="w-full max-w-2xl rounded-xl border-2 border-border shadow-lg"
          />
        </div>
      ) : isUpcoming && coverImage ? (
        <div class="my-6">
          <Image
            src={coverImage}
            alt={`${title} at ${venue.name}`}
            width={1600}
            height={900}
            class="w-full max-w-2xl rounded-xl border-2 border-border shadow-lg"
          />
        </div>
      ) : isUpcoming ? null : (
        <p class="my-6 text-muted-foreground italic">
          This talk was not recorded.
        </p>
      )
    }

    <div class="prose max-w-none">
      <Content />
    </div>

    {
      (sessionUrl ||
        registrationUrl ||
        slideDeck ||
        sourceCode ||
        additionalLinks.length > 0) && (
        <div class="flex flex-wrap gap-3 mt-6">
          {sessionUrl && (
            <a
              href={sessionUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-brand-solid text-brand-foreground font-semibold rounded-lg hover:bg-brand-solid-hover focus:bg-brand-solid-hover focus:outline-none transition-colors"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101M10.172 13.828a4 4 0 005.656 0l4-4a4 4 0 10-5.656-5.656l-1.102 1.101"
                />
              </svg>
              Session Details
            </a>
          )}
          {registrationUrl && (
            <a
              href={registrationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-foreground text-background font-semibold rounded-lg hover:opacity-90 focus:opacity-90 focus:outline-none transition-opacity"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15.75 5.25h3.375A2.625 2.625 0 0121.75 7.875v8.25a2.625 2.625 0 01-2.625 2.625H15.75M8.25 5.25H4.875A2.625 2.625 0 002.25 7.875v8.25A2.625 2.625 0 004.875 18.75H8.25M8.25 8.25h7.5M8.25 12h7.5M8.25 15.75h4.5"
                />
              </svg>
              Register
            </a>
          )}
          {slideDeck && (
            <a
              href={slideDeck}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-brand-solid text-brand-foreground font-semibold rounded-lg hover:bg-brand-solid-hover focus:bg-brand-solid-hover focus:outline-none transition-colors"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                />
              </svg>
              View Slides
            </a>
          )}
          {sourceCode && (
            <a
              href={sourceCode}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-foreground text-background font-semibold rounded-lg hover:opacity-90 focus:opacity-90 focus:outline-none transition-opacity"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
              Source Code
            </a>
          )}
          {additionalLinks.map((link: { title: string; url: string }) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 border-2 border-brand dark:border-brand text-brand font-semibold rounded-lg hover:bg-brand-solid hover:text-brand-foreground dark:hover:bg-brand-solid focus:bg-brand-solid focus:text-brand-foreground dark:focus:bg-brand-solid focus:outline-none transition-colors"
            >
              {link.title}
            </a>
          ))}
        </div>
      )
    }

    {
      tags && tags.length > 0 && (
        <footer class="pt-8">
          <div class="flex items-center gap-3 flex-wrap">
            <h2 class="text-xl font-semibold text-foreground">Tags:</h2>
            <div class="flex flex-wrap gap-2">
              <TagList tags={tags} />
            </div>
          </div>
        </footer>
      )
    }

    <RelatedContent talks={relatedTalks} posts={relatedPosts} />
  </article>
</Layout>
