---
export const prerender = false;

import { decodeSlug, getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import MainLayout from "../../layouts/MainLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import EmbedBlock from "../../components/EmbedBlock.astro";

const slug = decodeSlug(Astro.params.slug ?? "");
if (!slug) return Astro.rewrite("/404");

const { entry, error, cacheHint } = await getEmDashEntry("posts", slug);
if (error) return new Response("Could not load the post", { status: 500 });
if (!entry) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const title = typeof entry.data.title === "string" ? entry.data.title : slug;
const excerpt = typeof entry.data.excerpt === "string" ? entry.data.excerpt : undefined;
const content = entry.data.content;
---

<MainLayout title={title} metaDesc={excerpt} ogType="article">
  <article>
    <Breadcrumb items={[{ label: "Notes", href: "/cms" }, { label: title }]} />
    <h1 class="text-4xl font-bold tracking-tight text-foreground">{title}</h1>
    {
      excerpt && (
        <p class="mt-4 text-lg text-muted-foreground">{excerpt}</p>
      )
    }
    <div class="prose prose-lg mt-8 max-w-none">
      {content ? <PortableText value={content} components={{ type: { embed: EmbedBlock } }} /> : null}
    </div>
  </article>
</MainLayout>
