---
import { getCollection } from "astro:content";
import Layout from "../layouts/MainLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import TalkCard from "../components/TalkCard.astro";
import CopyButton from "../components/CopyButton";
import { Button } from "../components/Button";
import { dateFilter } from "../utils/filters";
import { markdownFilter } from "../utils/markdown";
export const prerender = true;

const now = new Date();
const allTalks = await getCollection("talks");
const upcomingTalks = allTalks
  .filter(
    (talk) =>
      talk.data.upcoming === true &&
      (talk.data.endDate ?? talk.data.date) >= now,
  )
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const featuredTalks = allTalks
  .filter((talk) => talk.data.featured === true && !talk.data.upcoming)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const speakerBioMarkdown = `**Nick Taylor** is a software engineer and developer advocate with 20+ years in the industry. A GitHub Star, [Agentic AI Foundation (AAIF) Ambassador](https://aaif.io/ambassadors/), AWS Community Builder, and Microsoft MVP, he has spoken at conferences across North America and Europe, runs a livestream, and publishes the [_One Tip a Week_](https://onetipaweek.com) newsletter. He currently works in developer relations at Pomerium, where the focus is Zero Trust security, MCP (Model Context Protocol), and agentic AI.`;
const speakerBioHtml = markdownFilter(speakerBioMarkdown);
---

<Layout
  title="Speaking | Nick Taylor"
  metaDesc="Invite Nick Taylor to speak at your conference or event. Topics include web development, open source, agentic AI, Zero Trust security, and MCP (Model Context Protocol)."
  socialImage="/assets/images/page-og/talks.jpg"
>
  <div class="space-y-12">
    <header class="space-y-6">
      <SectionHeader title="Speaking" headingLevel={1} />
      <p class="text-xl leading-relaxed text-muted-foreground max-w-2xl">
        I speak at conferences, meetups, and corporate events about the
        intersection of <strong>Zero Trust security</strong>,
        <strong>MCP (Model Context Protocol)</strong>, and
        <strong>agentic AI</strong>, along with the open-source tooling and
        infrastructure that makes it production-ready.
      </p>
      <div class="flex flex-wrap gap-4 pt-2">
        <Button href="mailto:nick@nickyt.co?subject=Speaking%20Inquiry">
          Invite me to speak
          <span class="text-xl">→</span>
        </Button>
        <a
          href="/talks"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-border px-5 py-2.5 text-base font-semibold leading-6 text-foreground transition-colors hover:bg-secondary focus:bg-secondary focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2 dark:focus:ring-offset-gray-900"
        >
          View all talks
        </a>
      </div>
    </header>

    {
      upcomingTalks.length > 0 && (
        <section class="space-y-6">
          <SectionHeader title="Upcoming Talks" headingLevel={2} />
          <div class="grid gap-6 xl:gap-8">
            {upcomingTalks.map((talk) => {
              const { date, endDate } = talk.data;
              const dateRange = endDate
                ? `${dateFilter(date)} – ${dateFilter(endDate)}`
                : dateFilter(date);
              return (
                <TalkCard
                  title={talk.data.title}
                  venueName={talk.data.venue.name}
                  venueUrl={talk.data.venue.url}
                  date={dateRange}
                  href={`/talks/${talk.id}`}
                  video={talk.data.video}
                  coverImage={talk.data.cover_image}
                />
              );
            })}
          </div>
        </section>
      )
    }

    {
      featuredTalks.length > 0 && (
        <section class="space-y-6">
          <SectionHeader title="Featured Talks" headingLevel={2} />
          <div class="grid gap-6 xl:gap-8">
            {featuredTalks.map((talk) => {
              const { date, endDate } = talk.data;
              const dateRange = endDate
                ? `${dateFilter(date)} – ${dateFilter(endDate)}`
                : dateFilter(date);
              return (
                <TalkCard
                  title={talk.data.title}
                  venueName={talk.data.venue.name}
                  venueUrl={talk.data.venue.url}
                  date={dateRange}
                  href={`/talks/${talk.id}`}
                  video={talk.data.video}
                  coverImage={talk.data.cover_image}
                  upcoming={talk.data.upcoming}
                />
              );
            })}
          </div>
        </section>
      )
    }

    <section class="space-y-6">
      <SectionHeader title="Talk Topics" headingLevel={2} />
      <div class="grid gap-6 lg:grid-cols-2">
        <div
          class="space-y-3 rounded-xl border border-border bg-secondary/30 p-6"
        >
          <h3 class="text-xl font-bold">
            Zero Trust Security for AI Agents &amp; MCP
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            Attendees learn where OAuth stops, where authorization gaps appear,
            and how to apply identity-aware access controls to real MCP
            deployments.
          </p>
        </div>

        <div
          class="space-y-3 rounded-xl border border-border bg-secondary/30 p-6"
        >
          <h3 class="text-xl font-bold">
            Securing OpenClaw &amp; AI Infrastructure
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            A hands-on look at protecting a self-hosted AI assistant and the
            infrastructure around it, with live demos of trusted-proxy
            authentication, policy enforcement, and safer remote access.
          </p>
        </div>

        <div
          class="space-y-3 rounded-xl border border-border bg-secondary/30 p-6"
        >
          <h3 class="text-xl font-bold">
            Kubernetes &amp; Cloud-Native Security
          </h3>
          <p class="text-muted-foreground leading-relaxed">
            Attendees leave with a practical model for applying Zero Trust to
            dynamic workloads, from identity-aware access at the edge to
            policies that keep changing infrastructure manageable.
          </p>
        </div>

        <div
          class="space-y-3 rounded-xl border border-border bg-secondary/30 p-6"
        >
          <h3 class="text-xl font-bold">Developer Tooling &amp; Open Source</h3>
          <p class="text-muted-foreground leading-relaxed">
            Lessons from shipping developer tools and open source at Netlify,
            dev.to, and in the wider community — including how to turn a rough
            idea into something developers can actually adopt.
          </p>
        </div>
      </div>
    </section>

    <section class="space-y-6">
      <SectionHeader title="Why book Nick?" headingLevel={2} />
      <p class="text-lg leading-relaxed text-muted-foreground">
        I bring technical depth, live demos, and stories from building in the
        open. I've spoken at Black Hat USA, AI Engineer Europe, All Things Open,
        ConFoo, SREday, and MCP Dev Summit, and can shape a session as a
        keynote, deep-dive, workshop, or panel.
      </p>
    </section>

    <section class="space-y-6">
      <SectionHeader title="Speaker Bio" headingLevel={2} />
      <div
        id="speaker-bio"
        data-bio={speakerBioMarkdown}
        class="relative rounded-xl border border-border bg-secondary/30 p-6"
      >
        <div class="absolute right-2 top-2">
          <CopyButton
            targetId="speaker-bio"
            label="Copy speaker bio"
            copiedMessage="Copied speaker bio to clipboard"
            errorMessage="Clipboard access was blocked. Select and copy the speaker bio manually."
            client:load
          />
        </div>
        <div
          class="pr-10 text-lg leading-relaxed text-muted-foreground [&_a]:text-brand [&_a]:font-semibold [&_a:hover]:underline [&_a:focus]:underline [&_a:focus]:outline-none"
          set:html={speakerBioHtml}
        />
      </div>
      <p class="text-sm leading-relaxed text-muted-foreground">
        Based in Montréal, Quebec, Canada. Available for keynotes, technical
        deep-dives, workshops, and panels.
      </p>
    </section>

    <section class="space-y-6">
      <SectionHeader title="Planning an event?" headingLevel={2} />
      <p class="text-lg leading-relaxed text-muted-foreground">
        Send the date, format, audience, and topic you're considering to
        <a
          href="mailto:nick@nickyt.co?subject=Speaking%20Inquiry"
          class="font-semibold text-brand hover:underline focus:underline focus:outline-none"
          >nick@nickyt.co</a
        >. I'll follow up with availability and a session that fits.
      </p>
      <p class="text-sm leading-relaxed text-muted-foreground">
        Prefer social? You can also <a
          href="/socials"
          class="font-semibold text-brand hover:underline focus:underline focus:outline-none"
          >find me online</a
        >.
      </p>
    </section>
  </div>
</Layout>
