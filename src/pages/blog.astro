---
import MainLayout from "../layouts/MainLayout.astro";
import BlogArchiveHeader from "../components/BlogArchiveHeader.astro";
import BlogArchiveYear from "../components/BlogArchiveYear.astro";
import BlogPostCard from "../components/BlogPostCard.astro";
import { getCollection } from "astro:content";
import { dateFilter } from "../utils/filters";

const allPosts = await getCollection("blog", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

// Sort by date descending
const sortedPosts = allPosts.sort((a, b) => {
  return b.data.date.getTime() - a.data.date.getTime();
});

// Group posts by year
const postsByYear = sortedPosts.reduce(
  (acc, post) => {
    const year = post.data.date.getFullYear();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(post);
    return acc;
  },
  {} as Record<number, typeof sortedPosts>
);

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));

const startHerePosts = sortedPosts
  .filter((post) => post.data.featured === true)
  .slice(0, 4);
const curatedStartHerePosts =
  startHerePosts.length >= 3 ? startHerePosts : sortedPosts.slice(0, 4);

// Transform data for components
const blogPostsByYear = years.map((year) => ({
  year,
  posts: postsByYear[Number(year)].map((post) => ({
    title: post.data.title,
    date: dateFilter(post.data.date),
    readTime: post.data.reading_time_minutes
      ? `${post.data.reading_time_minutes} min read`
      : null,
    url: `/blog/${post.id}`,
    coverImage: post.data.cover_image ?? null,
  })),
}));
---

<MainLayout
  title="Blog Posts - Archive"
  metaDesc="All blog posts by Nick Taylor"
  socialImage="/assets/images/page-og/blog.jpg"
>
  <BlogArchiveHeader totalPosts={sortedPosts.length} />
  <section class="mb-12 space-y-6" aria-labelledby="start-here-heading">
    <div>
      <h2 id="start-here-heading" class="text-3xl font-bold">Start here</h2>
      <p class="mt-2 max-w-2xl text-lg text-muted-foreground">
        Practical notes on AI engineering, developer tooling, open source, and
        the lessons I pick up while building.
      </p>
    </div>
    <div class="flex flex-wrap gap-2" aria-label="Blog topics">
      {[
        ["AI & MCP", "/tags/mcp/blog"],
        ["Security", "/tags/security/blog"],
        ["Developer tooling", "/tags/developertools/blog"],
        ["Open source", "/tags/opensource/blog"],
      ].map(([label, href]) => (
        <a
          href={href}
          class="rounded-full border border-border px-3 py-1.5 text-sm font-semibold text-foreground hover:bg-secondary focus:bg-secondary focus:outline-none"
        >
          {label}
        </a>
      ))}
    </div>
    <div class="grid gap-6 xl:gap-8">
      {curatedStartHerePosts.map((post) => (
        <BlogPostCard
          title={post.data.title}
          date={dateFilter(post.data.date)}
          image={post.data.cover_image}
          href={`/blog/${post.id}`}
          category="Start here"
        />
      ))}
    </div>
  </section>
  <div class="space-y-12">
    {
      blogPostsByYear.map((yearGroup) => (
        <BlogArchiveYear year={yearGroup.year} posts={yearGroup.posts} />
      ))
    }
  </div>
</MainLayout>
