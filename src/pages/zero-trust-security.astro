---
import { Image } from "astro:assets";
import { getCollection, getLiveCollection } from "astro:content";
import Layout from "../layouts/MainLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import GuideCard from "../components/GuideCard.astro";
import TalkCard from "../components/TalkCard.astro";
import { dateFilter } from "../utils/filters";
import { slugifyVideo } from "../utils/video-utils";

export const prerender = true;

const normalizeTag = (tag: string) => tag.toLowerCase().replace(/[\s-]+/g, "");
const hasAnyTag = (tags: string[] | undefined, wanted: string[]) => {
  const normalizedWanted = new Set(wanted.map(normalizeTag));
  return tags?.some((tag) => normalizedWanted.has(normalizeTag(tag))) ?? false;
};

const allGuides = await getCollection("guides");
const excludedSecurityGuides = new Set([
  "securing-mcp-servers-and-mcp-apps-with-pomerium",
]);
const securityGuides = allGuides
  .filter(
    (guide) =>
      !excludedSecurityGuides.has(guide.id) &&
      hasAnyTag(guide.data.tags, [
        "security",
        "zero trust",
        "security-policy",
        "runtime-enforcement",
        "ssh",
        "oauth",
      ]),
  )
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allTalks = await getCollection("talks");
const excludedSecurityTalks = new Set([
  "zero-trust--from-airports-to-identity-aware-proxies-sreday-san-francisco-2025-q2",
  "zero-trust--from-airports-to-identity-aware-proxies-sreday-london-2025-q1",
  "securing-mcp-servers-with-zero-trust-apollo-mcp-server-builder-series-2024",
  "agentic-access-oauth-gets-you-in-zero-trust-keeps-you-safe-commit-your-code-2025",
  "agentic-access-oauth-gets-you-in-zero-trust-keeps-you-safe-aicoding-2025",
  "agentic-access-oauth-gets-you-in-zero-trust-keeps-you-safe",
]);
const securityTalks = allTalks
  .filter(
    (talk) =>
      Boolean(talk.data.video) &&
      !excludedSecurityTalks.has(talk.id) &&
      hasAnyTag(talk.data.tags, [
        "security",
        "zero trust",
        "oauth",
        "identity",
        "pomerium",
        "ssh",
      ]),
  )
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const streamResult = await getLiveCollection("streamVideos");
const securityStreams = (streamResult.entries ?? [])
  .filter(
    (stream) =>
      stream.data.title !== "Spicy Cybersecurity Showdown" &&
      /zero trust|pomerium|identity-aware|oauth|authorization|security/i.test(
        stream.data.title,
      ),
  )
  .sort(
    (a, b) =>
      new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .slice(0, 6);

const externalArticles = [
  {
    title: "MCP Needs a Security Reality Check",
    description:
      "How proxy-enforced OAuth, token separation, auditing, and context-aware authorization close important gaps in production MCP deployments.",
    date: "June 18, 2025",
    href: "https://thenewstack.io/the-model-context-protocol-security-reality-check/",
    image: "https://cdn.thenewstack.io/media/2025/06/8d1e4c86-mcp12.png",
  },
  {
    title: "2.8 Million Reasons Why You Can't Trust Your VPN",
    description:
      "A practical explanation of how Zero Trust replaces perimeter assumptions with identity-aware, context-based access decisions.",
    date: "March 17, 2025",
    href: "https://thenewstack.io/2-8-million-reasons-why-you-cant-trust-your-vpn/",
    image: "https://cdn.thenewstack.io/media/2025/03/994fae75-reasons-cant-trust-vpn.jpg",
  },
];

const securityJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Zero Trust Security | Nick Taylor",
  description:
    "Talks, tutorials, courses, videos, and writing by Nick Taylor about Zero Trust security, identity-aware access, OAuth, authorization, and secure AI infrastructure.",
  url: "https://www.nickyt.co/zero-trust-security",
  about: [
    { "@type": "Thing", name: "Zero Trust security" },
    { "@type": "Thing", name: "Identity-aware access" },
    { "@type": "Thing", name: "AI agent security" },
  ],
};
---

<Layout
  title="Zero Trust Security | Nick Taylor"
  metaDesc="Practical Zero Trust security resources from Nick Taylor: identity-aware access, OAuth, authorization, SSH, secure AI agents, MCP, talks, tutorials, videos, and writing."
  socialImage="/assets/images/page-og/zero-trust-security.png"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(securityJsonLd)}
    />
  </Fragment>

  <Breadcrumb items={[{ label: "Zero Trust Security" }]} />

  <div class="space-y-6">
    <SectionHeader title="Zero Trust Security" headingLevel={1} />
    <p class="text-xl leading-relaxed text-muted-foreground">
      Practical talks, tutorials, videos, and writing about identity-aware
      access, OAuth, authorization, and policy enforcement for modern
      infrastructure, including AI agents and MCP servers.
    </p>
    <a
      href="/speaking"
      class="inline-flex items-center rounded-lg bg-brand-solid px-4 py-2.5 font-semibold text-brand-foreground transition-colors hover:bg-brand-solid-hover focus:bg-brand-solid-hover focus:outline-none"
    >
      Book me<span class="sr-only"> for a talk or guest appearance</span>
    </a>
  </div>

  <div class="mt-16 space-y-16">
    <section class="space-y-6" aria-label="Learn">
      <h2 class="text-3xl font-bold text-foreground">Learn</h2>
      <p class="text-lg text-muted-foreground">
        Hands-on material for putting identity and policy at the access
        boundary.
      </p>
      <div class="space-y-5">
        {securityGuides.map((guide) => (
          <GuideCard
            title={guide.data.title}
            description={guide.data.description}
            date={dateFilter(guide.data.date)}
            coverImage={guide.data.cover_image}
            href={guide.data.url}
            source={guide.data.source}
            category={guide.data.tags?.includes("mcp") ? "MCP security" : "Tutorial"}
          />
        ))}
      </div>
    </section>

    <section class="space-y-6" aria-label="Writing elsewhere">
      <h2 class="text-3xl font-bold text-foreground">Writing elsewhere</h2>
      <div class="space-y-5">
        {externalArticles.map((article) => (
          <article data-pagefind-ignore>
            <a
              href={article.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group grid gap-6 no-underline outline-none md:flex"
            >
              <div class="relative hidden h-22.5 w-40 shrink-0 overflow-hidden rounded-lg bg-muted md:block">
                <Image
                  src={article.image}
                  alt=""
                  width={320}
                  height={180}
                  class="h-full w-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="flex min-w-0 flex-1 flex-col justify-center">
                <h3 class="text-xl font-semibold leading-snug text-card-foreground group-hover:text-brand group-hover:underline group-focus:text-brand group-focus:underline">
                  {article.title}<span aria-hidden="true">↗</span>
                </h3>
                <p class="mt-2 text-base leading-relaxed text-muted-foreground">
                  {article.description}
                </p>
                <div class="mt-2 flex flex-wrap items-center gap-2 text-base text-muted-foreground">
                  <span class="font-semibold text-brand">The New Stack</span>
                  <span aria-hidden="true">•</span>
                  <time>{article.date}</time>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="space-y-6" aria-label="Talks">
      <h2 class="text-3xl font-bold text-foreground">Talks</h2>
      <div class="space-y-5">
        {securityTalks.map((talk) => (
          <TalkCard
            title={talk.data.title}
            venueName={talk.data.venue.name}
            venueUrl={talk.data.venue.url}
            date={dateFilter(talk.data.date)}
            href={`/talks/${talk.id}`}
            video={talk.data.video}
            coverImage={talk.data.cover_image}
            upcoming={talk.data.upcoming}
          />
        ))}
      </div>
      <a
        href="/talks"
        class="inline-flex items-center text-lg font-semibold text-foreground hover:text-brand focus:text-brand focus:outline-none"
      >
        Browse the talk archive
      </a>
    </section>

    {securityStreams.length > 0 && (
      <section class="space-y-6" aria-label="Livestreams">
        <h2 class="text-3xl font-bold text-foreground">Livestreams</h2>
        <div class="space-y-5">
          {securityStreams.map((stream) => (
            <TalkCard
              title={stream.data.title}
              venueName={
                stream.data.type === "pomerium-live"
                  ? "Pomerium Live"
                  : "Nickyt.live"
              }
              date={dateFilter(new Date(stream.data.date))}
              href={`/videos/${slugifyVideo(stream.data.title, stream.data.guestName)}`}
              video={{ type: "youtube", url: stream.data.youtubeStreamLink }}
            />
          ))}
        </div>
        <a
          href="/videos"
          class="inline-flex items-center text-lg font-semibold text-foreground hover:text-brand focus:text-brand focus:outline-none"
        >
          Browse the video archive
        </a>
      </section>
    )}
  </div>
  <div class="mt-16 border-t border-border pt-8">
    <a
      href="/tags/zerotrust"
      class="inline-flex items-center text-lg font-semibold text-foreground hover:text-brand focus:text-brand focus:outline-none"
    >
      Browse all Zero Trust-tagged content
    </a>
  </div>
</Layout>
