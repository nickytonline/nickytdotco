---
import { getLiveCollection } from "astro:content";
import Layout from "../../layouts/MainLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { dateFilter } from "../../utils/filters";
import { site } from "../../data/site";
import { markdownFilter } from "../../utils/markdown";
import YouTubeEmbed from "../../components/embeds/YouTubeEmbed.astro";
import UpcomingBadge from "../../components/UpcomingBadge.astro";
import EventCalendar from "../../components/EventCalendar";
import StreamLinks from "../../components/StreamLinks.astro";
import {
  extractYouTubeVideoId,
  slugifyVideo,
} from "../../utils/video-utils";
import { getLocalizedDate } from "../../utils/schedule-utils";
import {
  eventExpiryTimestamp,
  isEventUpcoming,
  setCdnCacheHeaders,
  setFixedCdnCacheHeaders,
  UNTIL_DEPLOY_CDN_CACHE_SECONDS,
} from "../../utils/cdn-cache";

export const prerender = false;

const TWITCH_STREAM_URL = "https://www.twitch.tv/nickytonline";

const { slug } = Astro.params;

if (!slug) {
  return Astro.rewrite("/404");
}

const result = await getLiveCollection("streamVideos");

if (result.error) {
  console.error("Error loading stream videos:", result.error);
  return Astro.rewrite("/404");
}

const stream = (result.entries ?? []).find(
  (entry) => slugifyVideo(entry.data.title, entry.data.guestName) === slug,
);

if (!stream) {
  return Astro.rewrite("/404");
}

const {
  title,
  date,
  description,
  guestName,
  guestTitle,
  youtubeStreamLink,
  linkedinStreamLink,
  type,
} = stream.data;
const now = Date.now();
const isUpcoming = isEventUpcoming(new Date(date), now);

const locale =
  Astro.request.headers.get("Accept-Language")?.split(",")[0] ||
  Astro.request.headers.get("Accept-Language") ||
  "en-US";
const { timezone: rawTimezone } = Astro.locals.netlify.context.geo;
const timezone = rawTimezone || "UTC";

const dateDisplay = isUpcoming
  ? getLocalizedDate({
      date,
      locale,
      timezone,
      showTime: true,
    })
  : dateFilter(new Date(date));

if (isUpcoming) {
  setCdnCacheHeaders(
    Astro.response.headers,
    eventExpiryTimestamp(new Date(date)),
    now,
  );
  Astro.response.headers.set("timezone", timezone);
  Astro.response.headers.set(
    "Netlify-Vary",
    "header=Accept-Language|timezone",
  );
} else {
  // Past pages are stable until the next deploy (no durable → purged on deploy).
  setFixedCdnCacheHeaders(
    Astro.response.headers,
    UNTIL_DEPLOY_CDN_CACHE_SECONDS,
  );
}
const descriptionHtml = markdownFilter(description);

const videoId = extractYouTubeVideoId(youtubeStreamLink);
const socialImage = videoId
  ? `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`
  : "/assets/images/page-og/watch.jpg";
const pageUrl = new URL(Astro.url.pathname, site.url).toString();
const eventName =
  guestName === "2Full2Stack"
    ? `2 Full 2 Stack - ${title}`
    : `${type === "pomerium-live" ? "Pomerium Live Stream" : "nickyt.live"}: ${title}`;
const twitchStreamUrl = type === "nickyt.live" ? TWITCH_STREAM_URL : undefined;
const videoJsonLd = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "@id": `${pageUrl}#video`,
  name: title,
  description,
  thumbnailUrl: new URL(socialImage, site.url).toString(),
  uploadDate: new Date(date).toISOString(),
  url: pageUrl,
  sameAs: youtubeStreamLink,
  ...(videoId && {
    embedUrl: `https://www.youtube.com/embed/${videoId}`,
  }),
  author: {
    "@type": "Person",
    name: site.authorName,
    url: site.url,
  },
  contributor: {
    "@type": "Person",
    name: guestName,
    ...(guestTitle && { jobTitle: guestTitle }),
  },
};

function normalizeLink(
  value: string,
  baseUrl: string,
  prefix = "",
): { href: string; handle: string } {
  if (value.startsWith("http://") || value.startsWith("https://")) {
    const handle = new URL(value).pathname.replace(/^\//, "");
    return { href: value, handle: prefix ? `${prefix}${handle}` : handle };
  }
  return {
    href: `${baseUrl}${value}`,
    handle: prefix ? `${prefix}${value}` : value,
  };
}

const socials: { label: string; href: string; handle: string }[] = [];
if (stream.data.twitter)
  socials.push({
    label: "X / Twitter",
    ...normalizeLink(stream.data.twitter, "https://x.com/", "@"),
  });
if (stream.data.bluesky)
  socials.push({
    label: "Bluesky",
    href: stream.data.bluesky.startsWith("http")
      ? stream.data.bluesky
      : `https://bsky.app/profile/${stream.data.bluesky}`,
    handle: `@${stream.data.bluesky.startsWith("http") ? new URL(stream.data.bluesky).pathname.replace(/^\/profile\//, "") : stream.data.bluesky}`,
  });
if (stream.data.github)
  socials.push({
    label: "GitHub",
    ...normalizeLink(stream.data.github, "https://github.com/"),
  });
if (stream.data.linkedin)
  socials.push({
    label: "LinkedIn",
    href: stream.data.linkedin.startsWith("http")
      ? stream.data.linkedin
      : `https://linkedin.com/in/${stream.data.linkedin}`,
    handle: stream.data.linkedin.replace(/^https?:\/\//, ""),
  });
if (stream.data.youtube)
  socials.push({
    label: "YouTube",
    href: stream.data.youtube.startsWith("http")
      ? stream.data.youtube
      : `https://youtube.com/@${stream.data.youtube}`,
    handle: stream.data.youtube.replace(/^https?:\/\//, ""),
  });
if (stream.data.twitch)
  socials.push({
    label: "Twitch",
    ...normalizeLink(stream.data.twitch, "https://twitch.tv/", "@"),
  });
if (stream.data.website)
  socials.push({
    label: "Website",
    href: stream.data.website,
    handle: stream.data.website.replace(/^https?:\/\//, ""),
  });
---

<Layout
  title={`${title} | Nick Taylor's Streams`}
  metaDesc={description}
  socialImage={socialImage}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(videoJsonLd)}
    />
  </Fragment>
  <Breadcrumb
    items={[
      { label: "Watch", href: "/watch" },
      { label: "Video Archives", href: "/videos" },
      { label: title },
    ]}
  />

  <article>
    <header>
      <h1
        class="text-4xl lg:text-5xl font-extrabold tracking-tight text-foreground leading-tight"
      >
        {title}
      </h1>
      <div
        class="flex flex-wrap items-center gap-2 leading-none text-lg text-muted-foreground mt-2"
      >
        <time datetime={new Date(date).toISOString()} class="italic">
          {dateDisplay}
        </time>
        {isUpcoming && <UpcomingBadge label="Upcoming livestream" />}
      </div>
      <p class="text-base text-muted-foreground mt-1">
        with <span class="font-semibold">{guestName}</span>
        {guestTitle && <span> — {guestTitle}</span>}
      </p>
      {
        isUpcoming && (
          <div class="mt-4 flex flex-col gap-3">
            <StreamLinks
              youtubeUrl={youtubeStreamLink}
              twitchUrl={twitchStreamUrl}
              linkedinUrl={linkedinStreamLink}
            />
            <EventCalendar
              eventDate={date}
              eventName={eventName}
              description={description}
              duration={90}
              location={youtubeStreamLink}
              client:visible
            />
          </div>
        )
      }
    </header>

    {
      videoId && (
        <div class="my-6">
          <YouTubeEmbed videoId={videoId} title={title} />
        </div>
      )
    }

    {
      !videoId && (
        <div class="my-6">
          <a
            href={youtubeStreamLink}
            class="text-brand hover:underline focus:underline"
          >
            Watch on YouTube
          </a>
        </div>
      )
    }

    <div class="prose max-w-none" set:html={descriptionHtml} />

    {
      socials.length > 0 && (
        <div class="mt-6 pt-6 border-t border-border">
          <h2 class="text-lg font-semibold mb-3">Links</h2>
          <ul class="list-disc list-inside">
            {socials.map(({ label, href, handle }) => (
              <li>
                {label}:{" "}
                <a
                  href={href}
                  class="text-sm font-medium text-brand hover:underline focus:underline"
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  {handle}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="mt-8">
      <a
        href="/videos"
        class="inline-flex items-center text-lg font-semibold text-foreground hover:text-brand focus:text-brand"
      >
        Back to video archives
      </a>
    </div>
  </article>
</Layout>
