---
import { getCollection } from "astro:content";
import { getBlogPosts } from "../../../emdash/blog";
import Layout from "../../../layouts/MainLayout.astro";
import SectionHeader from "../../../components/SectionHeader.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { dateFilter } from "../../../utils/filters";

export const prerender = false;

const tag = Astro.params.tag ?? "";
const contentType = Astro.params.type;
const normalizedTag = tag.toLowerCase().replace(/\s+/g, "");

if (contentType !== "blog" && contentType !== "talks") {
  return Astro.rewrite("/404");
}

function hasTag(tags: string[] | undefined): boolean {
  return (
    tags?.some(
      (item) => item.toLowerCase().replace(/\s+/g, "") === normalizedTag
    ) ?? false
  );
}

const talks = await getCollection("talks");
const blogPosts = await getBlogPosts();
const originalTagCase =
  talks
    .flatMap((talk) => talk.data.tags)
    .find(
      (item) => item.toLowerCase().replace(/\s+/g, "") === normalizedTag
    ) ??
  blogPosts
    .flatMap((post) => post.data.tags ?? [])
    .find(
      (item) => item.toLowerCase().replace(/\s+/g, "") === normalizedTag
    ) ??
  tag;

const sortedTalks =
  contentType === "talks"
    ? talks
        .filter((talk) => hasTag(talk.data.tags))
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    : [];
const sortedBlogPosts =
  contentType === "blog"
    ? blogPosts
        .filter((post) => hasTag(post.data.tags))
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    : [];
const displayTag = originalTagCase;
const totalCount = sortedTalks.length + sortedBlogPosts.length;

if (totalCount === 0) {
  return Astro.rewrite("/404");
}
const contentTypeLabel = contentType === "blog" ? "Blog Posts" : "Talks";
---

<Layout
  title={`${contentTypeLabel} tagged with "${tag}" | Nick Taylor`}
  metaDesc={`${contentTypeLabel} by Nick Taylor tagged with "${displayTag}".`}
  socialImage="/assets/images/page-og/tags.jpg"
>
  <Breadcrumb
    items={[
      { label: "Tags", href: "/tags" },
      { label: displayTag, href: `/tags/${tag}` },
      { label: contentTypeLabel },
    ]}
  />

  <div class="mb-12">
    <SectionHeader
      title={`${contentTypeLabel} tagged with "${displayTag}"`}
      headingLevel={1}
    />
    <p class="text-xl text-muted-foreground mt-6">
      Found {totalCount}
      {
        totalCount === 1
          ? contentType === "blog"
            ? "post"
            : "talk"
          : contentType === "blog"
            ? "posts"
            : "talks"
      } with this tag
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-4">
      <a
        href={`/tags/${tag}`}
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-base font-semibold transition-colors bg-secondary text-secondary-foreground hover:bg-brand-solid hover:text-brand-foreground focus:bg-brand-solid focus:text-brand-foreground dark:hover:bg-brand-solid dark:focus:bg-brand-solid"
      >
        All Content
      </a>
      <a
        href={`/tags/${tag}/blog`}
        class={`inline-flex items-center gap-2 px-4 py-2 rounded-lg text-base font-semibold transition-colors ${
          contentType === "blog"
            ? "bg-brand-solid text-brand-foreground hover:bg-brand-solid-hover focus:bg-brand-solid-hover focus:text-brand-foreground dark:bg-brand-solid"
            : "bg-secondary text-secondary-foreground hover:bg-brand-solid hover:text-brand-foreground focus:bg-brand-solid focus:text-brand-foreground dark:hover:bg-brand-solid dark:focus:bg-brand-solid"
        }`}
        aria-current={contentType === "blog" ? "page" : undefined}
      >
        Blog Posts
      </a>
      <a
        href={`/tags/${tag}/talks`}
        class={`inline-flex items-center gap-2 px-4 py-2 rounded-lg text-base font-semibold transition-colors ${
          contentType === "talks"
            ? "bg-brand-solid text-brand-foreground hover:bg-brand-solid-hover focus:bg-brand-solid-hover focus:text-brand-foreground dark:bg-brand-solid"
            : "bg-secondary text-secondary-foreground hover:bg-brand-solid hover:text-brand-foreground focus:bg-brand-solid focus:text-brand-foreground dark:hover:bg-brand-solid dark:focus:bg-brand-solid"
        }`}
        aria-current={contentType === "talks" ? "page" : undefined}
      >
        Talks
      </a>
    </div>

    <div class="mt-6">
      <a
        href="/tags"
        class="inline-flex items-center text-lg font-semibold text-foreground hover:text-brand focus:text-brand"
      >
        View all tags
      </a>
    </div>
  </div>

  <div class="space-y-12">
    {
      sortedBlogPosts.length > 0 && (
        <section>
          <div class="space-y-1">
            {sortedBlogPosts.map((post) => {
              const slug = post.id;
              const readTime = post.data.reading_time_minutes
                ? `${post.data.reading_time_minutes} min read`
                : null;
              return (
                <div class="py-5 px-6">
                  <div class="flex items-baseline justify-between gap-6">
                    <div class="flex-1">
                      <h2 class="text-xl font-bold">
                        <a
                          href={`/blog/${slug}`}
                          class="text-foreground hover:text-brand hover:underline focus:text-brand focus:underline dark:hover:text-brand dark:focus:text-brand"
                        >
                          {post.data.title}
                        </a>
                      </h2>
                      <div class="flex items-center gap-4 text-muted-foreground mt-2">
                        <span class="italic text-base">
                          {dateFilter(post.data.date)}
                        </span>
                        {readTime && (
                          <>
                            <span class="text-brand font-semibold">
                              •
                            </span>
                            <span class="text-base font-semibold text-brand">
                              {readTime}
                            </span>
                          </>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      )
    }

    {
      sortedTalks.length > 0 && (
        <section>
          <div class="space-y-1">
            {sortedTalks.map((talk) => {
              const slug = talk.id;
              return (
                <div class="py-5 px-6">
                  <div class="flex items-baseline justify-between gap-6">
                    <div class="flex-1">
                      <h2 class="text-xl font-bold">
                        <a
                          href={`/talks/${slug}`}
                          class="text-foreground hover:text-brand hover:underline focus:text-brand focus:underline dark:hover:text-brand dark:focus:text-brand"
                        >
                          {talk.data.title}
                        </a>
                      </h2>
                      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 text-muted-foreground mt-2">
                        <span class="text-base font-semibold text-brand">
                          {talk.data.venue.name}
                        </span>
                        <span class="hidden sm:inline text-brand font-semibold">
                          •
                        </span>
                        <span class="italic text-base">
                          {dateFilter(talk.data.date)}
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      )
    }

    {
      totalCount === 0 && (
        <div class="text-center py-12">
          <p class="text-xl text-muted-foreground">
            No content found with this tag.
          </p>
        </div>
      )
    }
  </div>
</Layout>
