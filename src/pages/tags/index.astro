---
import { getCollection } from "astro:content";
import Layout from "../../layouts/MainLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Tag from "@/components/Tag.astro";
import { curatedTagLabels, curatedTagSlugs } from "../../utils/tag-taxonomy";
export const prerender = true;

const talks = await getCollection("talks");
const blogPosts = await getCollection("blog");

// Extract all unique tags and count their occurrences
const tagCounts = new Map<string, number>();
const tagToOriginalCase = new Map<string, string>();

// Process talks
talks.forEach((talk) => {
  if (talk.data.tags) {
    talk.data.tags.forEach((tag) => {
      const normalizedTag = tag.toLowerCase().replace(/\s+/g, "");
      tagCounts.set(normalizedTag, (tagCounts.get(normalizedTag) || 0) + 1);
      tagToOriginalCase.set(normalizedTag, tag);
    });
  }
});

// Process blog posts
blogPosts.forEach((post) => {
  if (post.data.tags) {
    post.data.tags.forEach((tag) => {
      const normalizedTag = tag.toLowerCase().replace(/\s+/g, "");
      tagCounts.set(normalizedTag, (tagCounts.get(normalizedTag) || 0) + 1);
      // Keep the first occurrence's case
      if (!tagToOriginalCase.has(normalizedTag)) {
        tagToOriginalCase.set(normalizedTag, tag);
      }
    });
  }
});

// Sort tags by frequency (most frequent first)
const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1]);

// Create alphabetical list for alphabetical view
const alphabeticalTags = [...sortedTags].sort((a, b) =>
  a[0].localeCompare(b[0])
);
const curatedTags = sortedTags.filter(([tag]) => curatedTagSlugs.has(tag));
---

<Layout
  title="Tags | Nick Taylor"
  metaDesc="Explore Nick Taylor's content by topic — blog posts and talks tagged by subject."
  socialImage="/assets/images/page-og/tags.jpg"
>
  <div class="mb-12">
    <SectionHeader title="Tags" headingLevel={1} />
    <p class="text-xl text-muted-foreground mt-6">
      Explore content by topic — from web development and AI to developer
      tooling and beyond.
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-4">
      <a
        href="/tags"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-base font-semibold transition-colors bg-brand-solid text-white dark:bg-brand-solid focus:outline-none"
        aria-current="page"
      >
        All Tags
      </a>
      <a
        href="/tags/blog"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-base font-semibold transition-colors bg-secondary text-secondary-foreground hover:bg-brand-solid hover:text-white focus:bg-brand-solid focus:text-white dark:hover:bg-brand-solid dark:focus:bg-brand-solid focus:outline-none"
      >
        Blog Posts
      </a>
      <a
        href="/tags/talks"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-base font-semibold transition-colors bg-secondary text-secondary-foreground hover:bg-brand-solid hover:text-white focus:bg-brand-solid focus:text-white dark:hover:bg-brand-solid dark:focus:bg-brand-solid focus:outline-none"
      >
        Talks
      </a>
    </div>
  </div>

  <div class="space-y-16">
    <section>
      <div
        class="mb-8 pb-1 border-l-4 border-brand dark:border-brand pl-6 bg-linear-to-r from-brand-soft dark:from-brand-soft to-transparent flex items-center"
      >
        <div>
          <h2 class="text-3xl font-bold text-foreground">Curated topics</h2>
          <p class="text-muted-foreground mt-2">The topics I return to most</p>
        </div>
      </div>
      <div class="flex flex-wrap gap-3">
        {
          curatedTags.map(([tag, count]) => (
            <Tag tag={tag} label={curatedTagLabels[tag]} count={count} />
          ))
        }
      </div>
    </section>

    <details>
      <summary class="cursor-pointer text-3xl font-bold text-foreground">
        Browse all {alphabeticalTags.length} tags
      </summary>
      <div class="mt-8">
        <div
          class="mb-8 pb-1 border-l-4 border-brand dark:border-brand pl-6 bg-linear-to-r from-brand-soft dark:from-brand-soft to-transparent flex items-center"
        >
          <div>
            <h2 class="text-3xl font-bold text-foreground">All Tags</h2>
            <p class="text-muted-foreground mt-2">
              {alphabeticalTags.length} topics in alphabetical order
            </p>
          </div>
        </div>
        <div class="flex flex-wrap gap-3">
          {
            alphabeticalTags.map(([tag, count]) => (
              <Tag tag={tag} count={count} />
            ))
          }
        </div>
      </div>
    </details>

    {
      sortedTags.length === 0 && (
        <div class="text-center py-12">
          <p class="text-xl text-gray-500">No tags found.</p>
        </div>
      )
    }
  </div>
</Layout>
