---
import StreamSchedule from "../components/StreamSchedule.astro";
import SectionHeader from "../components/SectionHeader.astro";
import BlogPostCard from "../components/BlogPostCard.astro";
import Layout from "../layouts/MainLayout.astro";
import type { StreamGuestInfo } from "../utils/schedule-utils";
import { getLiveCollection } from "astro:content";
import { getCollection } from "astro:content";
import { dateFilter } from "../utils/filters";
import { fetchPastGuestsWithYouTube } from "../content/_loaders/stream-schedule";
import TalkCard from "../components/TalkCard.astro";
import GuideCard from "../components/GuideCard.astro";
import ProjectCard from "../components/ProjectCard.astro";

const allPosts = await getCollection("blog", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

const sortedPosts = allPosts.sort((a, b) => {
  return b.data.date.getTime() - a.data.date.getTime();
});

// Featured: evergreen, curated best work (excluded from Latest to avoid duplication)
const featuredPosts = sortedPosts
  .filter((p) => p.data.featured === true)
  .slice(0, 1);
const featuredPostIds = new Set(featuredPosts.map((p) => p.id));

// Latest fallback: recency feed, excludes featured posts
const recentPosts = sortedPosts
  .filter((p) => !featuredPostIds.has(p.id))
  .slice(0, 4);

const allTalks = await getCollection("talks");
const now = new Date();

// Featured talks: flagship, evergreen (must have a recording, not upcoming)
const featuredTalks = allTalks
  .filter((t) => t.data.featured === true && !t.data.upcoming)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 1);
const featuredTalkIds = new Set(featuredTalks.map((t) => t.id));

// Upcoming talks: all future events, not a capped subset.
const upcomingTalks = allTalks.filter(
  (t) => t.data.upcoming === true && (t.data.endDate ?? t.data.date) >= now,
);
const recentTalks = allTalks
  .filter(
    (t) =>
      !t.data.upcoming &&
      !featuredTalkIds.has(t.id) &&
      (t.data.endDate ?? t.data.date) < now,
  )
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const allGuides = await getCollection("guides");
const sortedGuides = allGuides.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const featuredGuides = sortedGuides
  .filter((g) => g.data.featured === true)
  .slice(0, 2);

const featuredProject = {
  owner: "nickytonline",
  name: "mcp-typescript-template",
  description:
    "Production-ready starter for building MCP servers in TypeScript, with Vite, Vitest, Pino logging, and Docker support out of the box.",
  url: "https://github.com/nickytonline/mcp-typescript-template",
  stargazerCount: 55,
  forkCount: 12,
  primaryLanguage: { name: "TypeScript", color: "var(--typescript)" },
  myRole: "Author & maintainer",
  links: [
    {
      label: "Read the build story",
      url: "/blog/build-your-first-or-next-mcp-server-with-the-typescript-mcp-template/",
    },
  ],
};

const locale =
  Astro.request.headers.get("Accept-Language")?.split(",")[0] ||
  Astro.request.headers.get("Accept-Language") ||
  "en-US";

let errorMessage = "";
let schedule: StreamGuestInfo[] = [];
let upcomingStreams: StreamGuestInfo[] = [];
let recentStreams: StreamGuestInfo[] = [];

const scheduleResult = await getLiveCollection("streamSchedule");

if (scheduleResult.error) {
  console.error("Error fetching stream schedule:", scheduleResult.error);
  errorMessage = "Error fetching stream schedule.";
} else {
  schedule = scheduleResult.entries?.map((entry) => entry.data) ?? [];
  upcomingStreams = schedule.filter(
    (stream) => new Date(stream.date).getTime() > now.getTime(),
  );
}

const upcomingEvents = [
  ...upcomingTalks.map((item) => ({
    kind: "talk" as const,
    item,
    timestamp: item.data.date.getTime(),
  })),
  ...upcomingStreams.map((item) => ({
    kind: "stream" as const,
    item,
    timestamp: new Date(item.date).getTime(),
  })),
].sort((a, b) => a.timestamp - b.timestamp);

const hasUpcomingEvents = upcomingEvents.length > 0;

if (!hasUpcomingEvents && !errorMessage) {
  recentStreams = await fetchPastGuestsWithYouTube();
}

const latestContent = [
  ...recentTalks.map((item) => ({
    kind: "talk" as const,
    item,
    date: item.data.endDate ?? item.data.date,
  })),
  ...recentStreams.map((item) => ({
    kind: "stream" as const,
    item,
    date: new Date(item.date),
  })),
  ...recentPosts.map((item) => ({
    kind: "post" as const,
    item,
    date: item.data.date,
  })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 4);

const { timezone: rawTimezone } = Astro.locals.netlify.context.geo;
const timezone = rawTimezone || "UTC";

if (!errorMessage) {
  Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=0, must-revalidate",
  );
  Astro.response.headers.set(
    "Netlify-CDN-Cache-Control",
    "public, max-age=259200, must-revalidate",
  );
  Astro.response.headers.set("timezone", timezone);
  Astro.response.headers.set("Netlify-Vary", "header=Accept-Language|timezone");
}

export const prerender = false;
---

<Layout
  title="Nick Taylor — Developer advocate at the intersection of AI, security, and software"
  metaDesc="Nick Taylor is a software engineer and developer advocate focused on MCP, agentic AI, Zero Trust security, developer tooling, and open source."
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Nick Taylor",
        alternateName: "@nickytonline",
        jobTitle: "Developer Advocate at Pomerium",
        url: "https://www.nickyt.co",
        sameAs: [
          "https://github.com/nickytonline",
          "https://linkedin.com/in/nickytonline",
          "https://dev.to/nickytonline",
          "https://bsky.app/profile/nickyt.online",
          "https://x.com/nickytonline",
          "https://youtube.com/@nickytonline",
          "https://twitch.tv/nickytonline",
        ],
        knowsAbout: [
          "Zero Trust Security",
          "Model Context Protocol (MCP)",
          "Agentic AI",
          "TypeScript",
          "Developer Advocacy",
          "OpenClaw",
        ],
        worksFor: {
          "@type": "Organization",
          name: "Pomerium",
          url: "https://pomerium.com",
        },
      })}
    />
  </Fragment>
  <div class="space-y-12">
    <section class="flex flex-col md:block overflow-hidden lg:mb-36">
      <img
        class="w-32 h-32 md:w-48 md:h-48 rounded-xl object-cover self-center mb-4 md:mb-0 md:float-left md:mr-8"
        src="/assets/images/colour-headshot-500x500.jpg"
        alt="Headshot of Nick Taylor"
        loading="eager"
      />
      <div class="space-y-4">
        <h1 class="text-3xl md:text-4xl font-bold">
          Developer advocate working at the intersection of AI, security, and software.
        </h1>
        <p class="text-lg leading-relaxed text-muted-foreground">
          <strong class="text-foreground"><em>Hi!</em> I'm Nick Taylor</strong> (<a
            href="/socials">@nickytonline</a
          >), a software engineer and developer advocate focused on MCP,
          agentic AI, Zero Trust security, developer tooling, and open source.
          I'm currently in developer relations at
          <a href="https://pomerium.com">Pomerium</a>.
        </p>
        <div class="flex flex-wrap gap-4 pt-2">
          <a
            href="/speaking"
            class="inline-flex items-center gap-2 rounded-lg bg-brand-solid px-5 py-2.5 text-base font-semibold text-brand-foreground transition-colors hover:bg-brand-solid-hover focus:bg-brand-solid-hover focus:outline-none"
          >
            Invite me to speak<span class="text-xl" aria-hidden="true">→</span>
          </a>
          <a
            href="/watch"
            class="inline-flex items-center gap-2 rounded-lg border border-border px-5 py-2.5 text-base font-semibold text-foreground transition-colors hover:bg-secondary focus:bg-secondary focus:outline-none"
          >
            Watch latest videos<span class="text-xl" aria-hidden="true">→</span>
          </a>
        </div>
        <p class="pt-2 text-sm font-medium text-muted-foreground">
          20+ years in software · GitHub Star · AAIF Ambassador · AWS Community
          Builder · Microsoft MVP
        </p>
      </div>
    </section>

    {/* ── Featured: evergreen, curated best work ── */}
    {
      featuredTalks.length > 0 ||
      featuredGuides.length > 0 ||
      featuredPosts.length > 0 ? (
        <section class="space-y-10">
          <SectionHeader title="Start here" headingLevel={2} />
          <p class="max-w-2xl text-lg text-muted-foreground">
            A few of my best recent talks, tutorials, and practical notes on
            building with AI while keeping access secure.
          </p>

          {featuredTalks.length > 0 && (
            <div class="space-y-4">
              <h3 class="sr-only">Talks</h3>
              <div class="grid gap-6 xl:gap-8">
                {featuredTalks.map((talk) => (
                  <TalkCard
                    title={talk.data.title}
                    venueName={talk.data.venue.name}
                    venueUrl={talk.data.venue.url}
                    date={dateFilter(talk.data.date)}
                    href={`/talks/${talk.id}`}
                    video={talk.data.video}
                    coverImage={talk.data.cover_image}
                    category="Talk"
                  />
                ))}
              </div>
            </div>
          )}

          {featuredGuides.length > 0 && (
            <div class="space-y-4">
              <h3 class="sr-only">Hands-On Tutorials</h3>
              <div class="grid gap-6 xl:gap-8">
                {featuredGuides.map((guide) => (
                  <GuideCard
                    title={guide.data.title}
                    description={guide.data.description}
                    date={dateFilter(guide.data.date)}
                    coverImage={guide.data.cover_image}
                    href={guide.data.url}
                    source={guide.data.source}
                    category="Hands-on tutorial"
                  />
                ))}
              </div>
            </div>
          )}

          {featuredPosts.length > 0 && (
            <div class="space-y-4">
              <h3 class="sr-only">Writing</h3>
              <div class="grid gap-6 xl:gap-8">
                {featuredPosts.map((post) => (
                  <BlogPostCard
                    title={post.data.title}
                    date={dateFilter(post.data.date)}
                    image={post.data.cover_image}
                    href={`/blog/${post.id}`}
                    category="Writing"
                  />
                ))}
              </div>
            </div>
          )}
        </section>
      ) : null
    }

    <section class="space-y-6">
      <SectionHeader title="Featured project" headingLevel={2} />
      <p class="max-w-2xl text-lg text-muted-foreground">
        A production-ready starting point for building MCP servers in
        TypeScript.
      </p>
      <div class="max-w-2xl">
        <ProjectCard project={featuredProject} />
      </div>
    </section>

    {
      hasUpcomingEvents ? (
        <section class="space-y-10">
          <SectionHeader title="Upcoming Events" headingLevel={2} />

          <div class="grid gap-6 xl:gap-8">
            {upcomingEvents.map((event) => (
              <div data-upcoming-event data-event-timestamp={event.timestamp}>
                {event.kind === "talk" ? (
                  <TalkCard
                    title={event.item.data.title}
                    venueName={event.item.data.venue.name}
                    venueUrl={event.item.data.venue.url}
                    date={dateFilter(event.item.data.date)}
                    href={`/talks/${event.item.id}`}
                    video={event.item.data.video}
                    coverImage={event.item.data.cover_image}
                    upcoming={true}
                    upcomingLabel="Talk"
                    category="Talk"
                  />
                ) : (
                  <StreamSchedule
                    schedule={[event.item]}
                    locale={locale}
                    timezone={timezone}
                  />
                )}
              </div>
            ))}
          </div>

          {errorMessage && <p class="text-destructive">{errorMessage}</p>}
        </section>
      ) : (
        <section class="space-y-10">
          <SectionHeader title="Latest" headingLevel={2} />

          {latestContent.length > 0 && (
            <div class="grid gap-6 xl:gap-8">
              {latestContent.map((content) => {
                if (content.kind === "talk") {
                  return (
                    <TalkCard
                      title={content.item.data.title}
                      venueName={content.item.data.venue.name}
                      venueUrl={content.item.data.venue.url}
                      date={dateFilter(content.item.data.date)}
                      href={`/talks/${content.item.id}`}
                      video={content.item.data.video}
                      coverImage={content.item.data.cover_image}
                      category="Talk"
                    />
                  );
                }

                if (content.kind === "stream") {
                  return (
                    <StreamSchedule
                      schedule={[content.item]}
                      locale={locale}
                      timezone={timezone}
                    />
                  );
                }

                return (
                  <BlogPostCard
                    title={content.item.data.title}
                    date={dateFilter(content.item.data.date)}
                    image={content.item.data.cover_image}
                    href={`/blog/${content.item.id}`}
                    category="Writing"
                  />
                );
              })}
            </div>
          )}

          {errorMessage && <p class="text-destructive">{errorMessage}</p>}
        </section>
      )
    }

    <section
      class="flex flex-col gap-4 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between"
      aria-labelledby="newsletter-heading"
    >
      <h2 id="newsletter-heading" class="sr-only">Newsletter</h2>
      <p class="text-lg text-muted-foreground">
        Developer tools, AI workflows, Git, productivity, and other things I
        actually use. One developer tip a week. Short &amp; valuable. That's it!
      </p>
      <a
        href="https://OneTipAWeek.com?utm_source=nickytco&utm_medium=homepage"
        target="_blank"
        class="inline-flex w-fit items-center gap-2 rounded-lg bg-brand-solid px-5 py-2.5 text-base font-semibold text-brand-foreground transition-colors hover:bg-brand-solid-hover focus:bg-brand-solid-hover focus:outline-none dark:bg-brand-solid dark:hover:bg-brand-solid"
      >
        Subscribe<span class="text-xl" aria-hidden="true">→</span>
      </a>
    </section>
  </div>
</Layout>
