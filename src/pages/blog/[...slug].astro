---
export const prerender = false;

import Post from "../../layouts/Post.astro";
import { getLiveBlogPost } from "../../emdash/blog";

const slug = Astro.params.slug ?? "";
const entry = slug ? await getLiveBlogPost(slug) : undefined;
if (!entry || (import.meta.env.PROD && entry.data.draft)) {
  return Astro.rewrite("/404");
}
---

<Post entry={entry} />
