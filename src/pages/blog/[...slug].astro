---
export const prerender = false;

import Post from "../../layouts/Post.astro";
import { getBlogPostResult } from "../../emdash/blog";
import { resolveRelatedVariant } from "../../emdash/related-variant";
import {
  cacheRenderedContent,
  CONTENT_CACHE_MAX_AGE_SECONDS,
} from "../../utils/route-cache";

const slug = Astro.params.slug ?? "";
const result = slug ? await getBlogPostResult(slug) : undefined;

if (!result?.post || (import.meta.env.PROD && result.post.data.draft)) {
  return Astro.rewrite("/404");
}

const entry = result.post;
const testEnabled = import.meta.env.RELATED_AB_TEST === "on";

const assignment = resolveRelatedVariant({
  testEnabled,
  query: Astro.url.searchParams.get("related_variant"),
  cookie: Astro.cookies.get("related_variant")?.value ?? null,
});

if (assignment.persist) {
  Astro.cookies.set("related_variant", assignment.variant, {
    path: "/",
    maxAge: 60 * 60 * 24 * 30,
    sameSite: "lax",
    secure: import.meta.env.PROD,
  });
}

if (testEnabled) {
  Astro.response.headers.set("Netlify-Vary", "query,cookie=related_variant");
}

cacheRenderedContent(
  Astro.response.headers,
  Astro.cache,
  result.cacheHint,
  CONTENT_CACHE_MAX_AGE_SECONDS,
);
---

<Post entry={entry} variant={assignment.variant} />
