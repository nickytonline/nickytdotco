---
import { Image } from "astro:assets";
import Pill from "./Pill.astro";

interface Props {
  title: string;
  date: string;
  image?: string | null;
  href: string;
  category?: string;
}

const { title, date, image, href, category } = Astro.props;

if (!image) {
  console.warn(`BlogPostCard is missing an image for post: ${title}`);
}
---

<article>
  <a
    href={href}
    class="group grid md:flex gap-6 xl:gap-8 no-underline transition-colors"
  >
    {
      image && (
        <div class="relative shrink-0 hidden md:block w-40 h-22.5 rounded-lg overflow-hidden bg-muted">
          <Image
            src={image}
            alt=""
            width={320}
            height={180}
            class="w-full h-full object-cover"
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }
    <div class="flex-1 flex flex-col justify-center gap-2 min-w-0">
      <h3
        class="text-xl font-semibold leading-snug text-balance text-card-foreground group-hover:text-brand group-hover:underline group-focus:text-brand group-focus:underline dark:group-hover:text-brand dark:group-focus:text-brand"
      >
        {title}
      </h3>
      <time class="italic text-base text-muted-foreground font-normal"
        >{date}</time
      >
      {
        category && (
          <div class="pt-1">
            <Pill label={category} aria-hidden="true" />
          </div>
        )
      }
    </div>
  </a>
</article>
