---
interface Props {
  title: string;
  headingLevel?: 1 | 2;
  visuallyHidden?: boolean;
}

const { title, headingLevel = 2, visuallyHidden = false } = Astro.props;
const baseHeadingClasses =
  "text-5xl font-extrabold tracking-tight text-balance";
const sectionHeadingClasses = "text-3xl font-bold text-foreground";
const headingClasses =
  headingLevel === 1 ? baseHeadingClasses : sectionHeadingClasses;
---

<div class="mb-8">
  {
    headingLevel === 1 ? (
      <h1
        class={visuallyHidden ? "sr-only" : headingClasses}
        data-pagefind-meta="title"
      >
        {title}
      </h1>
    ) : (
      <h2 class={visuallyHidden ? "sr-only" : headingClasses}>{title}</h2>
    )
  }
  {
    !visuallyHidden && headingLevel === 1 && (
      <div class="w-20 h-1.5 bg-linear-to-r from-pink-600 to-brand rounded-full mt-3"></div>
    )
  }
</div>
