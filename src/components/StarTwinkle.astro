---
---

<span id="star-twinkle" class="star-twinkle" aria-hidden="true">
  <svg
    class="star-twinkle__icon"
    viewBox="0 0 24 24"
    width="100%"
    height="100%"
    focusable="false"
  >
    <!-- Classic 4-point sparkle (✦), upright — not a tilted + -->
    <path
      d="M12 1L14.2 9.8L23 12L14.2 14.2L12 23L9.8 14.2L1 12L9.8 9.8Z"
      fill="currentColor"></path>
  </svg>
</span>

<script is:inline>
  function startStarTwinkle() {
    if (window.__starTwinkleStarted) return;
    window.__starTwinkleStarted = true;

    const GRID = 16;
    // Ambient: less often than every 10s; jitter so it does not feel metronomic.
    const MIN_INTERVAL_MS = 14000;
    const MAX_INTERVAL_MS = 22000;
    const FIRST_DELAY_MS = 2500;
    const TWINKLE_MS = 1100;
    const MIN_WIDTH = 1024;

    const el = document.getElementById("star-twinkle");

    if (!(el instanceof HTMLElement)) return;

    let timer = 0;
    let busy = false;
    let enabled = false;

    const nextDelay = () =>
      MIN_INTERVAL_MS +
      Math.floor(Math.random() * (MAX_INTERVAL_MS - MIN_INTERVAL_MS + 1));

    const canTwinkle = () =>
      window.matchMedia(`(min-width: ${MIN_WIDTH}px)`).matches &&
      !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
      !document.documentElement.classList.contains("windows95");

    const pickPosition = () => {
      const overlayLeft = window.innerWidth * 0.4;
      const overlayWidth = window.innerWidth * 0.6;
      const cols = Math.max(1, Math.floor(overlayWidth / GRID));
      const rows = Math.max(1, Math.floor(window.innerHeight / GRID));

      // Bias toward the top-right, where the dotted mask is densest.
      const col = Math.min(
        cols - 1,
        Math.floor((1 - Math.pow(Math.random(), 1.6)) * cols),
      );

      const row = Math.min(
        rows - 1,
        Math.floor(Math.pow(Math.random(), 1.8) * rows),
      );

      return {
        left: overlayLeft + col * GRID + GRID / 2,
        top: row * GRID + GRID / 2,
      };
    };

    const schedule = (delay) => {
      if (timer) window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        timer = 0;
        twinkle();

        if (enabled) schedule(nextDelay());
      }, delay);
    };

    const twinkle = () => {
      if (busy || !canTwinkle()) return;
      busy = true;

      const { left, top } = pickPosition();
      el.style.left = `${left}px`;
      el.style.top = `${top}px`;
      el.classList.remove("star-twinkle--active");
      // Restart the CSS animation even if the class was already present.
      void el.offsetWidth;
      el.classList.add("star-twinkle--active");

      window.setTimeout(() => {
        el.classList.remove("star-twinkle--active");
        busy = false;
      }, TWINKLE_MS);
    };

    const sync = () => {
      const nextEnabled = canTwinkle();
      el.hidden = !nextEnabled;

      if (!nextEnabled) {
        el.classList.remove("star-twinkle--active");
        busy = false;
        enabled = false;

        if (timer) {
          window.clearTimeout(timer);
          timer = 0;
        }

        return;
      }

      if (!enabled) {
        enabled = true;
        schedule(FIRST_DELAY_MS);
      }
    };

    sync();
    window.addEventListener("resize", sync, { passive: true });
    window
      .matchMedia("(prefers-reduced-motion: reduce)")
      .addEventListener("change", sync);
    window
      .matchMedia(`(min-width: ${MIN_WIDTH}px)`)
      .addEventListener("change", sync);
    new MutationObserver(sync).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }

  startStarTwinkle();

  document.addEventListener("astro:page-load", startStarTwinkle);
</script>
