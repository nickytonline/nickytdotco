---
// Theme switcher: visible three-way control (light | dark | Windows 95)
---

<div
  id="theme-switcher"
  role="radiogroup"
  aria-label="Color theme"
  class="theme-switcher inline-flex border border-border bg-secondary text-secondary-foreground"
>
  <button
    type="button"
    role="radio"
    data-theme="light"
    aria-checked="false"
    aria-label="Light"
    title="Light"
    class="theme-switcher__option inline-flex h-9 w-9 items-center justify-center hover:text-brand focus:text-brand"
  >
    <svg
      class="h-5 w-5"
      fill="currentColor"
      viewBox="0 0 20 20"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
        fill-rule="evenodd"
        clip-rule="evenodd"></path>
    </svg>
  </button>
  <button
    type="button"
    role="radio"
    data-theme="dark"
    aria-checked="false"
    aria-label="Dark"
    title="Dark"
    class="theme-switcher__option inline-flex h-9 w-9 items-center justify-center hover:text-brand focus:text-brand"
  >
    <svg
      class="h-5 w-5"
      fill="currentColor"
      viewBox="0 0 20 20"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
      ></path>
    </svg>
  </button>
  <button
    type="button"
    role="radio"
    data-theme="windows95"
    aria-checked="false"
    aria-label="Windows 95"
    title="Windows 95"
    class="theme-switcher__option inline-flex h-9 w-9 items-center justify-center hover:text-brand focus:text-brand"
  >
    <svg
      class="h-5 w-5"
      fill="currentColor"
      viewBox="0 0 20 20"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path d="M3 3h6v6H3V3zm8 0h6v6h-6V3zM3 11h6v6H3v-6zm8 0h6v6h-6v-6z"></path>
    </svg>
  </button>
</div>

<script>
  type ThemeName = "light" | "dark" | "windows95";

  const isThemeName = (
    value: string | null | undefined
  ): value is ThemeName =>
    value === "light" || value === "dark" || value === "windows95";

  const getThemePreference = (): ThemeName => {
    if (typeof localStorage !== "undefined") {
      const stored = localStorage.getItem("theme");
      if (isThemeName(stored)) {
        return stored;
      }
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };

  const setTheme = (
    theme: ThemeName,
    container: ParentNode = document
  ): void => {
    const html = document.documentElement;
    html.classList.remove("dark", "windows95");
    if (theme === "dark" || theme === "windows95") {
      html.classList.add(theme);
    }

    const switcher = container.querySelector("#theme-switcher");
    const options =
      switcher?.querySelectorAll<HTMLButtonElement>("[data-theme]") ?? [];

    options.forEach((option) => {
      const isSelected = option.dataset.theme === theme;
      option.setAttribute("aria-checked", isSelected ? "true" : "false");
      option.tabIndex = isSelected ? 0 : -1;
      option.classList.toggle("theme-switcher__option--active", isSelected);
    });
  };

  const initThemeSwitcher = () => {
    const switcher = document.getElementById("theme-switcher");

    if (switcher?.dataset.initialized === "true") {
      return;
    }

    setTheme(getThemePreference());

    switcher?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) {
        return;
      }
      const option = target.closest<HTMLButtonElement>("[data-theme]");
      const theme = option?.dataset.theme;
      if (!isThemeName(theme)) {
        return;
      }
      setTheme(theme);
      localStorage.setItem("theme", theme);
    });

    switcher?.addEventListener("keydown", (event) => {
      if (
        event.key !== "ArrowRight" &&
        event.key !== "ArrowLeft" &&
        event.key !== "ArrowDown" &&
        event.key !== "ArrowUp" &&
        event.key !== "Home" &&
        event.key !== "End"
      ) {
        return;
      }

      const options = [
        ...switcher.querySelectorAll<HTMLButtonElement>("[data-theme]"),
      ];
      const currentIndex = options.findIndex(
        (option) => option.getAttribute("aria-checked") === "true"
      );
      if (currentIndex < 0) {
        return;
      }

      event.preventDefault();

      let nextIndex = currentIndex;
      if (event.key === "Home") {
        nextIndex = 0;
      } else if (event.key === "End") {
        nextIndex = options.length - 1;
      } else if (event.key === "ArrowRight" || event.key === "ArrowDown") {
        nextIndex = (currentIndex + 1) % options.length;
      } else {
        nextIndex = (currentIndex - 1 + options.length) % options.length;
      }

      const nextTheme = options[nextIndex]?.dataset.theme;
      if (!isThemeName(nextTheme)) {
        return;
      }
      setTheme(nextTheme);
      localStorage.setItem("theme", nextTheme);
      options[nextIndex]?.focus();
    });

    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", (e) => {
        if (!localStorage.getItem("theme")) {
          setTheme(e.matches ? "dark" : "light");
        }
      });

    if (switcher) {
      switcher.dataset.initialized = "true";
    }
  };

  initThemeSwitcher();

  // Re-initialize after navigation (will skip if already initialized)
  document.addEventListener("astro:page-load", initThemeSwitcher);
</script>
