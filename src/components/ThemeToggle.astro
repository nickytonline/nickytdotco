---
// Theme switcher: compact trigger that opens options below.
// Options stay a radiogroup for accessibility.
---

<div class="theme-switcher relative inline-flex" data-theme-switcher>
  <button
    type="button"
    id="theme-switcher-trigger"
    class="theme-switcher__trigger inline-flex h-9 w-9 items-center justify-center border border-border bg-secondary text-secondary-foreground hover:text-brand focus:text-brand"
    aria-label="Color theme"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="theme-switcher-menu"
    title="Color theme"
  >
    <svg
      data-trigger-icon="light"
      class="theme-switcher__trigger-icon hidden h-5 w-5"
      fill="currentColor"
      viewBox="0 0 20 20"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
        fill-rule="evenodd"
        clip-rule="evenodd"></path>
    </svg>
    <svg
      data-trigger-icon="dark"
      class="theme-switcher__trigger-icon hidden h-5 w-5"
      fill="currentColor"
      viewBox="0 0 20 20"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path
        d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
      ></path>
    </svg>
    <!-- Generic four-pane window glyph — not the Microsoft Windows logo -->
    <svg
      data-trigger-icon="windows95"
      class="theme-switcher__trigger-icon hidden h-5 w-5"
      fill="currentColor"
      viewBox="0 0 20 20"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path d="M3 3h6v6H3V3zm8 0h6v6h-6V3zM3 11h6v6H3v-6zm8 0h6v6h-6v-6z"></path>
    </svg>
  </button>

  <div
    id="theme-switcher-menu"
    role="radiogroup"
    aria-label="Color theme options"
    class="theme-switcher__menu"
    hidden
  >
    <button
      type="button"
      role="radio"
      data-theme="light"
      aria-checked="false"
      aria-label="Light"
      title="Light"
      class="theme-switcher__option inline-flex h-9 w-9 items-center justify-center hover:text-brand focus:text-brand"
      tabindex="-1"
    >
      <svg
        class="h-5 w-5"
        fill="currentColor"
        viewBox="0 0 20 20"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
          fill-rule="evenodd"
          clip-rule="evenodd"></path>
      </svg>
    </button>
    <button
      type="button"
      role="radio"
      data-theme="dark"
      aria-checked="false"
      aria-label="Dark"
      title="Dark"
      class="theme-switcher__option inline-flex h-9 w-9 items-center justify-center hover:text-brand focus:text-brand"
      tabindex="-1"
    >
      <svg
        class="h-5 w-5"
        fill="currentColor"
        viewBox="0 0 20 20"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
        ></path>
      </svg>
    </button>
    <button
      type="button"
      role="radio"
      data-theme="windows95"
      aria-checked="false"
      aria-label="Windows 95"
      title="Windows 95"
      class="theme-switcher__option inline-flex h-9 w-9 items-center justify-center hover:text-brand focus:text-brand"
      tabindex="-1"
    >
      <svg
        class="h-5 w-5"
        fill="currentColor"
        viewBox="0 0 20 20"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path d="M3 3h6v6H3V3zm8 0h6v6h-6V3zM3 11h6v6H3v-6zm8 0h6v6h-6v-6z"
        ></path>
      </svg>
    </button>
  </div>
</div>

<script>
  type ThemeName = "light" | "dark" | "windows95";

  const THEME_LABELS: Record<ThemeName, string> = {
    light: "Light",
    dark: "Dark",
    windows95: "Windows 95",
  };

  const isThemeName = (
    value: string | null | undefined
  ): value is ThemeName =>
    value === "light" || value === "dark" || value === "windows95";

  const getThemePreference = (): ThemeName => {
    if (typeof localStorage !== "undefined") {
      const stored = localStorage.getItem("theme");
      if (isThemeName(stored)) {
        return stored;
      }
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };

  const getOpenDirection = (): "down" => "down";

  const syncTrigger = (
    theme: ThemeName,
    root: ParentNode = document
  ): void => {
    const trigger = root.querySelector<HTMLButtonElement>(
      "#theme-switcher-trigger"
    );
    if (!trigger) {
      return;
    }

    trigger.querySelectorAll<HTMLElement>("[data-trigger-icon]").forEach(
      (icon) => {
        icon.classList.toggle(
          "hidden",
          icon.dataset.triggerIcon !== theme
        );
      }
    );

    const label = `Color theme: ${THEME_LABELS[theme]}. Open theme options`;
    trigger.setAttribute("aria-label", label);
    trigger.setAttribute("title", label);
  };

  const setTheme = (
    theme: ThemeName,
    container: ParentNode = document
  ): void => {
    const html = document.documentElement;
    html.classList.remove("dark", "windows95");
    if (theme === "dark" || theme === "windows95") {
      html.classList.add(theme);
    }

    const menu = container.querySelector("#theme-switcher-menu");
    const options =
      menu?.querySelectorAll<HTMLButtonElement>("[data-theme]") ?? [];

    options.forEach((option) => {
      const isSelected = option.dataset.theme === theme;
      option.setAttribute("aria-checked", isSelected ? "true" : "false");
      option.classList.toggle("theme-switcher__option--active", isSelected);
    });

    syncTrigger(theme, container);
  };

  const setOpen = (
    root: HTMLElement,
    open: boolean,
    focusTarget: "trigger" | "selected" | "none" = "none"
  ): void => {
    const trigger = root.querySelector<HTMLButtonElement>(
      "#theme-switcher-trigger"
    );
    const menu = root.querySelector<HTMLElement>("#theme-switcher-menu");
    if (!trigger || !menu) {
      return;
    }

    root.dataset.open = open ? "true" : "false";
    root.dataset.direction = getOpenDirection();
    trigger.setAttribute("aria-expanded", open ? "true" : "false");

    if (open) {
      menu.hidden = false;
      // Force reflow so the open transition runs after un-hiding.
      void menu.offsetWidth;
      root.classList.add("theme-switcher--open");
    } else {
      root.classList.remove("theme-switcher--open");
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
      if (prefersReducedMotion) {
        menu.hidden = true;
      }
    }

    const options = [
      ...menu.querySelectorAll<HTMLButtonElement>("[data-theme]"),
    ];
    options.forEach((option) => {
      option.tabIndex = open ? 0 : -1;
    });

    if (focusTarget === "trigger") {
      trigger.focus();
    } else if (focusTarget === "selected") {
      const selected =
        options.find(
          (option) => option.getAttribute("aria-checked") === "true"
        ) ?? options[0];
      selected?.focus();
    }
  };

  const initThemeSwitcher = () => {
    const root = document.querySelector<HTMLElement>("[data-theme-switcher]");
    const trigger = document.getElementById(
      "theme-switcher-trigger"
    ) as HTMLButtonElement | null;
    const menu = document.getElementById("theme-switcher-menu");

    if (!root || !trigger || !menu || root.dataset.initialized === "true") {
      return;
    }

    setTheme(getThemePreference());
    setOpen(root, false);

    const closeIfOpen = (focusTrigger = false) => {
      if (root.dataset.open === "true") {
        setOpen(root, false, focusTrigger ? "trigger" : "none");
      }
    };

    trigger.addEventListener("click", (event) => {
      event.stopPropagation();
      const willOpen = root.dataset.open !== "true";
      setOpen(root, willOpen, willOpen ? "selected" : "none");
    });

    menu.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) {
        return;
      }
      const option = target.closest<HTMLButtonElement>("[data-theme]");
      const theme = option?.dataset.theme;
      if (!isThemeName(theme)) {
        return;
      }
      setTheme(theme);
      localStorage.setItem("theme", theme);
      setOpen(root, false, "trigger");
    });

    menu.addEventListener("keydown", (event) => {
      if (root.dataset.open !== "true") {
        return;
      }

      if (event.key === "Escape") {
        event.preventDefault();
        setOpen(root, false, "trigger");
        return;
      }

      if (
        event.key !== "ArrowRight" &&
        event.key !== "ArrowLeft" &&
        event.key !== "ArrowDown" &&
        event.key !== "ArrowUp" &&
        event.key !== "Home" &&
        event.key !== "End"
      ) {
        return;
      }

      const options = [
        ...menu.querySelectorAll<HTMLButtonElement>("[data-theme]"),
      ];
      const currentIndex = options.findIndex(
        (option) => option === document.activeElement
      );
      const fallbackIndex = options.findIndex(
        (option) => option.getAttribute("aria-checked") === "true"
      );
      const activeIndex = currentIndex >= 0 ? currentIndex : fallbackIndex;
      if (activeIndex < 0) {
        return;
      }

      event.preventDefault();

      let nextIndex = activeIndex;
      if (event.key === "Home") {
        nextIndex = 0;
      } else if (event.key === "End") {
        nextIndex = options.length - 1;
      } else if (event.key === "ArrowDown" || event.key === "ArrowRight") {
        nextIndex = (activeIndex + 1) % options.length;
      } else if (event.key === "ArrowUp" || event.key === "ArrowLeft") {
        nextIndex = (activeIndex - 1 + options.length) % options.length;
      }

      const nextTheme = options[nextIndex]?.dataset.theme;
      if (!isThemeName(nextTheme)) {
        return;
      }
      setTheme(nextTheme);
      localStorage.setItem("theme", nextTheme);
      options[nextIndex]?.focus();
    });

    trigger.addEventListener("keydown", (event) => {
      if (
        event.key === "ArrowDown" ||
        event.key === "Enter" ||
        event.key === " "
      ) {
        if (root.dataset.open !== "true") {
          event.preventDefault();
          setOpen(root, true, "selected");
        }
      } else if (event.key === "Escape") {
        closeIfOpen(true);
      }
    });

    menu.addEventListener("transitionend", (event) => {
      if (
        event.target === menu &&
        event.propertyName === "opacity" &&
        root.dataset.open !== "true"
      ) {
        menu.hidden = true;
      }
    });

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Node) || !root.contains(event.target)) {
        closeIfOpen();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeIfOpen(true);
      }
    });

    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", (e) => {
        if (!localStorage.getItem("theme")) {
          setTheme(e.matches ? "dark" : "light");
        }
      });

    root.dataset.initialized = "true";
  };

  initThemeSwitcher();

  // Re-initialize after navigation (will skip if already initialized)
  document.addEventListener("astro:page-load", initThemeSwitcher);
</script>
