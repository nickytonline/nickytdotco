---
import ThemeToggle from "./ThemeToggle.astro";
import Search from "./Search";

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);
const navItems = [
  { label: "Home", href: "/" },
  { label: "Watch", href: "/watch" },
  { label: "Speaking", href: "/speaking" },
  { label: "Blog", href: "/blog" },
  { label: "Newsletter", href: "/newsletter" },
  { label: "Projects", href: "/projects" },
  { label: "About", href: "/about" },
  { label: "Socials", href: "/socials" },
];
const isCurrent = (href: string) =>
  href === "/" ? currentPath === "" : currentPath.startsWith(href.slice(1));
---

<header class="pt-6 pb-6 max-w-7xl mx-auto px-6 transition-colors">
  <div
    class="flex flex-col items-center gap-6 md:flex-row md:items-start md:justify-between"
  >
    <div class="flex w-full flex-col items-center gap-4 md:w-auto md:items-start md:gap-6">
      <h1
        class="font-heading md:text-6xl lg:text-8xl font-medium"
        transition:name="header-logo"
      >
        <a href="/" class="text-current no-underline"
          >nickyt<span class="text-brand">.</span>co</a
        >
      </h1>
      <nav
        aria-label="main navigation"
        class="mt-2 hidden text-xl md:block md:text-2xl lg:text-3xl"
      >
        <ul class="list-none flex gap-6 place-content-center flex-wrap">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
                class="nav-link"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <details class="group w-full md:hidden">
        <summary
          class="flex cursor-pointer list-none items-center justify-center gap-2 rounded-lg border border-border px-4 py-2 text-lg font-semibold text-foreground hover:bg-secondary focus:outline-none [&::-webkit-details-marker]:hidden"
        >
          Menu
          <span aria-hidden="true" class="text-brand transition-transform group-open:rotate-180">⌄</span>
        </summary>
        <nav aria-label="main navigation" class="pt-4 text-lg">
          <ul class="flex list-none flex-col items-center gap-3">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? "page" : undefined}
                  class="nav-link"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
    <div class="flex items-center gap-4">
      <a
        href="/feed.xml"
        class="inline-flex hover:text-brand focus:text-brand focus:outline-none"
        target="_blank"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="w-4.5 h-4.5 lg:w-5 lg:h-5"
        >
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
        <span class="sr-only">Subscribe via RSS Feed</span>
      </a>
      <Search client:load transition:persist />
      <ThemeToggle transition:persist />
    </div>
  </div>
</header>
