---
import SectionHeader from "./SectionHeader.astro";

const { description } = Astro.props;
---

<div class="mb-6">
  <SectionHeader title="Blog" headingLevel={1} />
  <p class="text-xl text-muted-foreground mt-6">
    {
      description ||
        "Practical notes on secure AI infrastructure, security, developer tooling, software engineering, and open source."
    }
  </p>
</div>
