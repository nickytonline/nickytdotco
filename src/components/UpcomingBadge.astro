---
interface Props {
  label?: string;
}

const { label = "Upcoming" } = Astro.props;
---

<span
  class="inline-flex items-center self-start rounded-md border border-brand/30 bg-brand-soft px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-[0.12em] text-brand-soft-foreground"
>
  {label}
</span>
