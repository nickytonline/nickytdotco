---
import "../styles/global.css";
import OgMetaTags from "../components/OgMetaTags.astro";
import Header from "../components/Header.astro";
import SkipLink from "../components/SkipLink.astro";
import BackToTop from "../components/BackToTop.astro";
import site from "@/data/site";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  metaDesc?: string;
  socialImage?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
}

const {
  title,
  metaDesc = "Nick Taylor builds and teaches secure AI infrastructure, developer tooling, and open source through talks, videos, writing, and projects.",
  socialImage = "/assets/images/page-og/home.jpg",
  ogType,
  publishedTime,
} = Astro.props;
const { origin } = new URL(Astro.request.url);
const canonicalUrl = `${origin}${Astro.url.pathname}`;
const fullTitle = title.includes("Nick Taylor")
  ? title
  : `${title} | Nick Taylor`;
const gaMeasurementId = import.meta.env.GA_MEASUREMENT_ID;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={site.faviconPath} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS Feed for Nick Taylor's Blog"
      href={`${origin}/feed.xml`}
    />
    <link rel="canonical" href={canonicalUrl} />
    <OgMetaTags
      title={fullTitle}
      description={metaDesc}
      socialImage={new URL(socialImage, origin).href}
      url={canonicalUrl}
      type={ogType}
      publishedTime={publishedTime}
    />
    <slot name="head" />
    <title>{fullTitle}</title>
    <ClientRouter />
    <!-- Fix back-button regression with ClientRouter: on the very first page load
         the router calls replaceState, which erases the "came from external page"
         history entry. Pushing a duplicate entry before that happens restores it. -->
    <script is:inline>
      if (!history.state?.["astro"]) {
        history.pushState({ astro: { index: 0 } }, "", location.href);
      }
    </script>
    <!-- Prevent flash of unstyled content -->
    <script is:inline>
      // Check for saved theme preference or default to system preference
      const applyThemeClass = (root, theme) => {
        root.classList.remove("dark", "windows95");
        if (theme === "dark" || theme === "windows95") {
          root.classList.add(theme);
        }
      };

      const resolveTheme = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      };

      applyThemeClass(document.documentElement, resolveTheme());

      document.addEventListener("astro:before-swap", (ev) => {
        applyThemeClass(ev.newDocument.documentElement, resolveTheme());
      });
    </script>
    {
      gaMeasurementId && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}
          />
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaMeasurementId}');`}
          />
        </>
      )
    }
  </head>
  <body class="pb-32 font-sans">
    <SkipLink id="main" />
    <div data-site-window>
      <Header />
      <main
        id="main"
        class="max-w-[65ch] lg:max-w-[70ch] mx-auto px-6 py-12 text-base lg:text-lg"
      >
        <slot />
      </main>
      <footer data-site-footer class="pt-8 text-center px-6">
        <div
          class="mx-auto flex max-w-4xl flex-col items-center gap-4 text-lg text-muted-foreground"
        >
          <nav aria-label="Footer navigation" class="text-sm">
            <a
              href="/uses"
              class="hover:text-brand focus:text-brand"
            >
              Uses
            </a>
          </nav>
          <p class="text-sm">&copy; {currentYear} Nick Taylor</p>
        </div>
      </footer>
    </div>
    <div data-win-taskbar>
      <a href="/">Start</a>
      <button type="button" data-win-action="restore" data-win-task>
        <img
          src={site.faviconPath}
          alt=""
          width="16"
          height="16"
          data-win-task-icon
        />
        nickyt.co
      </button>
      <time data-win-clock>--:--</time>
    </div>
    <script is:inline>
      if (!window.__winClockStarted) {
        window.__winClockStarted = true;
        const tickWinClock = () => {
          const clock = document.querySelector("[data-win-clock]");
          if (!(clock instanceof HTMLTimeElement)) return;
          const now = new Date();
          clock.dateTime = now.toISOString();
          clock.textContent = now.toLocaleTimeString(undefined, {
            hour: "numeric",
            minute: "2-digit",
          });
        };
        tickWinClock();
        window.setInterval(tickWinClock, 30000);
        document.addEventListener("astro:page-load", tickWinClock);
      }

      if (!window.__winWindowStarted) {
        window.__winWindowStarted = true;
        const winStateKey = "win-window-state";
        let lastOpenState = "open";

        const readWinState = () => {
          const saved = sessionStorage.getItem(winStateKey);
          if (
            saved === "open" ||
            saved === "maximized" ||
            saved === "minimized" ||
            saved === "closed"
          ) {
            return saved;
          }
          return "open";
        };

        const applyWinState = (state) => {
          const root = document.documentElement;
          if (!root.classList.contains("windows95")) {
            delete root.dataset.winState;
            return;
          }
          root.dataset.winState = state;
          const maximize = document.querySelector(
            "[data-win-action='maximize']",
          );
          if (maximize instanceof HTMLButtonElement) {
            const isMaximized = state === "maximized";
            maximize.setAttribute(
              "aria-label",
              isMaximized ? "Restore" : "Maximize",
            );
            maximize.setAttribute(
              "aria-pressed",
              isMaximized ? "true" : "false",
            );
          }
        };

        const setWinState = (state) => {
          if (state === "open" || state === "maximized") {
            lastOpenState = state;
          }
          sessionStorage.setItem(winStateKey, state);
          applyWinState(state);
        };

        const syncWinState = () => {
          if (!document.documentElement.classList.contains("windows95")) {
            delete document.documentElement.dataset.winState;
            return;
          }
          const saved = readWinState();
          if (saved === "open" || saved === "maximized") {
            lastOpenState = saved;
          }
          applyWinState(saved);
        };

        let titleClickTimer = 0;

        const cancelTitleClick = () => {
          window.clearTimeout(titleClickTimer);
          titleClickTimer = 0;
        };

        const toggleMaximized = () => {
          const current = document.documentElement.dataset.winState || "open";
          if (current === "minimized" || current === "closed") return;
          setWinState(current === "maximized" ? "open" : "maximized");
        };

        const titleLinkFrom = (target) => {
          if (!(target instanceof Element)) return null;
          if (!document.documentElement.classList.contains("windows95")) {
            return null;
          }
          const titleLink = target.closest("[data-site-header] .site-logo a");
          return titleLink instanceof HTMLAnchorElement ? titleLink : null;
        };

        // Win95/98: a double-click on the title bar toggles maximize. Hold the
        // title link's first click until the double-click window closes so
        // that gesture does not navigate home.
        document.addEventListener(
          "pointerdown",
          (event) => {
            if (event.detail < 2) return;
            if (!titleLinkFrom(event.target)) return;
            cancelTitleClick();
          },
          true,
        );

        document.addEventListener(
          "click",
          (event) => {
            const titleLink = titleLinkFrom(event.target);
            if (!titleLink) return;

            if (event.detail > 1) {
              cancelTitleClick();
              event.preventDefault();
              event.stopPropagation();
              return;
            }

            if (event.detail !== 1) return;

            event.preventDefault();
            event.stopPropagation();
            cancelTitleClick();
            titleClickTimer = window.setTimeout(() => {
              titleClickTimer = 0;
              titleLink.dispatchEvent(
                new MouseEvent("click", {
                  bubbles: true,
                  cancelable: true,
                  view: window,
                }),
              );
            }, 500);
          },
          true,
        );

        document.addEventListener("dblclick", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          if (!document.documentElement.classList.contains("windows95")) return;
          if (!target.closest("[data-site-header] .site-logo")) return;

          cancelTitleClick();
          event.preventDefault();
          toggleMaximized();
        });

        document.addEventListener("click", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          if (!document.documentElement.classList.contains("windows95")) return;

          const control = target.closest("[data-win-action]");
          if (control instanceof HTMLElement && control.dataset.winAction) {
            const action = control.dataset.winAction;
            const current = document.documentElement.dataset.winState || "open";
            if (action === "minimize") setWinState("minimized");
            else if (action === "close") setWinState("closed");
            else if (action === "maximize") {
              setWinState(current === "maximized" ? "open" : "maximized");
            } else if (action === "restore") {
              setWinState(lastOpenState === "maximized" ? "maximized" : "open");
            }
            return;
          }

          const start = target.closest("[data-win-taskbar] a[href='/']");
          if (!start) return;
          setWinState("open");
          if (location.pathname === "/") event.preventDefault();
        });

        syncWinState();
        document.addEventListener("astro:page-load", syncWinState);
        new MutationObserver(syncWinState).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["class"],
        });
      }
    </script>
    <BackToTop transition:persist />
  </body>
</html>
